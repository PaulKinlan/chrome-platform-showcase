      "id": "flow-start-retained-roundtrip",
      "description": "A flow-start declaration set through the CSSOM survives the parser and reads back from the inline style.",
      "kind": "script",
      "test": "(()=>{const e=document.createElement('div');e.style.setProperty('justify-content','flow-start');const v=e.style.getPropertyValue('justify-content');return v==='flow-start';})()",
      "specSection": "https://github.com/w3c/csswg-drafts/pull/14539"
    },
    {
      "id": "flex-start-serializes-as-flow-start",
      "description": "True aliasing: assigning flex-start reads back as flow-start from the specified style, per the CSSWG serialization resolution.",
      "kind": "script",
      "test": "(()=>{const e=document.createElement('div');e.style.justifyContent='flex-start';return e.style.justifyContent==='flow-start';})()",
      "specSection": "https://github.com/w3c/csswg-drafts/pull/14539"
    },
    {
      "id": "computed-serializes-as-flow-start",
      "description": "getComputedStyle also reports flow-start for an element assigned flex-start.",
      "kind": "script",
      "test": "(()=>{const e=document.createElement('div');e.style.cssText='display:flex;position:absolute;visibility:hidden;';e.style.justifyContent='flex-start';document.body.appendChild(e);const v=getComputedStyle(e).justifyContent;e.remove();return v==='flow-start';})()",
      "specSection": "https://github.com/w3c/csswg-drafts/pull/14539"
    },
    {
      "id": "flow-relative-divergence-under-reversal",
      "description": "The underlying semantic the alias names: in a row-reverse flexbox, flex-start places the first item at a different physical offset than the logical start keyword.",
      "kind": "script",
      "test": "(()=>{const f=document.createElement('div');f.style.cssText='display:flex;flex-direction:row-reverse;width:300px;position:absolute;visibility:hidden;';const a=document.createElement('div');a.style.cssText='flex:0 0 50px;height:10px;';f.appendChild(a);document.body.appendChild(f);f.style.justifyContent='flex-start';const flexPos=a.getBoundingClientRect().left-f.getBoundingClientRect().left;f.style.justifyContent='start';const startPos=a.getBoundingClientRect().left-f.getBoundingClientRect().left;f.remove();return Math.round(flexPos)!==Math.round(startPos);})()",
      "specSection": "https://drafts.csswg.org/css-align-3/#positional-values"
    }
  ]
