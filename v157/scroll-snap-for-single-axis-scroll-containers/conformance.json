  "assertions": [
    {
      "id": "overflow-auto-clip-parses",
      "description": "The two-value overflow shorthand accepts a scrollable value paired with clip (overflow: auto clip).",
      "kind": "css-supports",
      "test": "overflow: auto clip",
      "specSection": "https://drafts.csswg.org/css-overflow-3/#propdef-overflow"
    },
    {
      "id": "clip-preserved-next-to-auto",
      "description": "overflow-x: auto with overflow-y: clip computes to clip, establishing a single-axis scroll container instead of being coerced to hidden.",
      "kind": "script",
      "test": "(()=>{const e=document.createElement('div');e.style.cssText='overflow-x:auto;overflow-y:clip;position:absolute;visibility:hidden;width:10px;height:10px;';document.body.appendChild(e);const y=getComputedStyle(e).overflowY;e.remove();return y==='clip';})()",
      "specSection": "https://github.com/explainers-by-googlers/single-axis-scroll-containers"
    },
    {
      "id": "snap-align-per-axis-pair",
      "description": "scroll-snap-align accepts a two-value per-axis form (start none), the opt-out the propagation model relies on.",
      "kind": "css-supports",
      "test": "scroll-snap-align: start none",
      "specSection": "https://drafts.csswg.org/css-scroll-snap-1/#scroll-snap-align"
    },
    {
      "id": "programmatic-scroll-resnaps-control",
      "description": "Control contract: a y-mandatory scroll container with a direct snap area re-aligns a programmatic misaligned scrollTop to the snap position, which is the method the propagation assertion depends on.",
      "kind": "script",
      "test": "(async()=>{const o=document.createElement('div');o.style.cssText='height:200px;overflow-y:auto;scroll-snap-type:y mandatory;width:200px;position:absolute;visibility:hidden;';for(let i=0;i<4;i++){const s=document.createElement('div');s.style.cssText='height:150px;scroll-snap-align:start;';o.appendChild(s);}document.body.appendChild(o);o.scrollTop=97;await new Promise(r=>setTimeout(r,400));const v=Math.round(o.scrollTop);o.remove();return Math.abs(v-150)<=1;})()",
      "specSection": "https://drafts.csswg.org/css-scroll-snap-1/#re-snap"
    },
    {
      "id": "y-snap-propagates-through-clipped-lane",
      "description": "A snap area inside an overflow-x:auto / overflow-y:clip container propagates its vertical alignment to the nearest ancestor y scroll container, which re-snaps a misaligned programmatic scroll onto it.",
      "kind": "script",
      "test": "(async()=>{const o=document.createElement('div');o.style.cssText='height:200px;overflow-y:auto;scroll-snap-type:y mandatory;width:200px;position:absolute;visibility:hidden;';const f=document.createElement('div');f.style.cssText='height:150px;';o.appendChild(f);const lane=document.createElement('div');lane.style.cssText='overflow-x:auto;overflow-y:clip;width:200px;';const row=document.createElement('div');row.style.cssText='display:flex;width:400px;';for(let i=0;i<3;i++){const c=document.createElement('div');c.style.cssText='flex:0 0 150px;height:100px;scroll-snap-align:start;';row.appendChild(c);}lane.appendChild(row);o.appendChild(lane);const t=document.createElement('div');t.style.cssText='height:400px;';o.appendChild(t);document.body.appendChild(o);o.scrollTop=113;await new Promise(r=>setTimeout(r,400));const v=Math.round(o.scrollTop);o.remove();return Math.abs(v-150)<=1;})()",
      "specSection": "https://github.com/explainers-by-googlers/single-axis-scroll-snap#proposal"
    },
    {
      "id": "hidden-lane-still-traps",
      "description": "Compatibility contract: the same rig with overflow-y:hidden on the lane remains a two-axis scroll container that traps the vertical alignment, so the outer scroller stays misaligned.",
      "kind": "script",
      "test": "(async()=>{const o=document.createElement('div');o.style.cssText='height:200px;overflow-y:auto;scroll-snap-type:y mandatory;width:200px;position:absolute;visibility:hidden;';const f=document.createElement('div');f.style.cssText='height:150px;';o.appendChild(f);const lane=document.createElement('div');lane.style.cssText='overflow-x:auto;overflow-y:hidden;width:200px;';const row=document.createElement('div');row.style.cssText='display:flex;width:400px;';for(let i=0;i<3;i++){const c=document.createElement('div');c.style.cssText='flex:0 0 150px;height:100px;scroll-snap-align:start;';row.appendChild(c);}lane.appendChild(row);o.appendChild(lane);const t=document.createElement('div');t.style.cssText='height:400px;';o.appendChild(t);document.body.appendChild(o);o.scrollTop=113;await new Promise(r=>setTimeout(r,400));const v=Math.round(o.scrollTop);o.remove();return v===113;})()",
      "specSection": "https://github.com/explainers-by-googlers/single-axis-scroll-snap#compatibility"
    }
  ]
}
