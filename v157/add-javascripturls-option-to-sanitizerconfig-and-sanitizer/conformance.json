      "specSection": "https://html.spec.whatwg.org/#dom-sanitizer-setjavascripturls"
    },
    {
      "id": "safe-config-canonicalises-to-false",
      "description": "A default (safe-preset) Sanitizer canonicalises javascriptURLs to false in get().",
      "kind": "script",
      "test": "(()=>{return new Sanitizer().get().javascriptURLs === false;})()",
      "specSection": "https://github.com/whatwg/html/pull/12898"
    },
    {
      "id": "explicit-true-respected-in-config",
      "description": "SanitizerConfig accepts javascriptURLs: true and get() round-trips it.",
      "kind": "script",
      "test": "(()=>{return new Sanitizer({javascriptURLs:true}).get().javascriptURLs === true;})()",
      "specSection": "https://github.com/whatwg/html/pull/12898"
    },
    {
      "id": "setter-returns-changed-boolean",
      "description": "setJavascriptURLs(allow) returns true only when the stored value changed (true, then false on the repeat, then true to flip back).",
      "kind": "script",
      "test": "(()=>{const s=new Sanitizer();return s.setJavascriptURLs(true)===true && s.setJavascriptURLs(true)===false && s.setJavascriptURLs(false)===true;})()",
      "specSection": "https://html.spec.whatwg.org/#dom-sanitizer-setjavascripturls"
    },
    {
      "id": "remove-unsafe-forces-false",
      "description": "removeUnsafe() sets javascriptURLs back to false even when the config asked for true — safe methods therefore always strip javascript: URLs.",
      "kind": "script",
      "test": "(()=>{const s=new Sanitizer({javascriptURLs:true});s.removeUnsafe();return s.get().javascriptURLs===false;})()",
      "specSection": "https://github.com/whatwg/html/pull/12898"
    },
    {
      "id": "safe-sethtml-strips-javascript-href",
      "description": "Element.setHTML() removes a javascript: href from an anchor (the unchanged safe-path default).",
      "kind": "script",
      "test": "(()=>{const d=document.createElement('div');d.setHTML('<a href=\"javascript:alert(1)\">x</a>');const a=d.querySelector('a');return a===null || !a.hasAttribute('href');})()",
      "specSection": "https://html.spec.whatwg.org/#sanitizer-api"
    },
    {
      "id": "unsafe-optin-strips-with-sanitizer-proof",
      "description": "setHTMLUnsafe() with { javascriptURLs: false } strips the javascript: href while an element-allowlist side effect proves the sanitizer actually ran (an ignored unknown dictionary member cannot pass this).",
      "kind": "script",
      "test": "(()=>{const d=document.createElement('div');d.setHTMLUnsafe('<i>i</i><a href=\"javascript:alert(1)\">x</a>',{sanitizer:{elements:['a'],attributes:['href'],javascriptURLs:false}});const a=d.querySelector('a');return d.querySelector('i')===null && a!==null && !a.hasAttribute('href');})()",
      "specSection": "https://github.com/whatwg/html/pull/12898"
    },
    {
      "id": "unsafe-explicit-true-preserves",
      "description": "setHTMLUnsafe() with { javascriptURLs: true } preserves the javascript: href, with the same allowlist side effect proving the sanitizer ran.",
      "kind": "script",
      "test": "(()=>{const d=document.createElement('div');d.setHTMLUnsafe('<i>i</i><a href=\"javascript:alert(1)\">x</a>',{sanitizer:{elements:['a'],attributes:['href'],javascriptURLs:true}});const a=d.querySelector('a');return d.querySelector('i')===null && a!==null && a.getAttribute('href')==='javascript:alert(1)';})()",
      "specSection": "https://github.com/whatwg/html/pull/12898"
