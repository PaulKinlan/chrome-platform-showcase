      "kind": "script",
      "test": "CSS.supports('position-visibility', 'anchor-visible')",
      "specSection": "https://drafts.csswg.org/css-anchor-position-1/#position-visibility"
    },
    {
      "id": "singular-anchor-valid-parses",
      "description": "The renamed singular value `position-visibility: anchor-valid` is accepted.",
      "kind": "script",
      "test": "CSS.supports('position-visibility', 'anchor-valid')",
      "specSection": "https://drafts.csswg.org/css-anchor-position-1/#position-visibility"
    },
    {
      "id": "plural-anchors-visible-still-parses",
      "description": "The plural `anchors-visible` is DEPRECATED, not removed — this proposal explicitly keeps the old names working as aliases, so a stylesheet that never migrated must not break.",
      "kind": "script",
      "test": "CSS.supports('position-visibility', 'anchors-visible')",
      "specSection": "https://drafts.csswg.org/css-anchor-position-1/#position-visibility"
    },
    {
      "id": "plural-aliases-to-singular",
      "description": "Setting the plural `anchors-visible` serialises back as the singular `anchor-visible` — the observable signature of an alias, as opposed to two independent values that merely both parse.",
      "kind": "script",
      "test": "(() => { const el = document.createElement('div'); el.style.setProperty('position-visibility', 'anchors-visible'); return el.style.getPropertyValue('position-visibility') === 'anchor-visible'; })()",
      "specSection": "https://drafts.csswg.org/css-anchor-position-1/#position-visibility"
    },
    {
      "id": "dual-write-resolves-to-singular",
      "description": "The forward-compatible migration pattern works: declaring the plural then the singular leaves the singular in effect, because the later valid declaration wins the cascade.",
      "kind": "script",
      "test": "(() => { const el = document.createElement('div'); el.style.setProperty('position-visibility', 'anchors-visible'); el.style.setProperty('position-visibility', 'anchor-visible'); return el.style.getPropertyValue('position-visibility') === 'anchor-visible'; })()",
      "specSection": "https://drafts.csswg.org/css-anchor-position-1/#position-visibility"
    },
    {
      "id": "singular-values-compose",
      "description": "Both singular conditions can be combined in one declaration, as the plural forms could.",
      "kind": "script",
      "test": "CSS.supports('position-visibility', 'anchor-valid anchor-visible')",
      "specSection": "https://drafts.csswg.org/css-anchor-position-1/#position-visibility"
    }
