{
  "license": "Apache-2.0",
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-read --allow-env server.ts",
    "start": "deno run --allow-net --allow-read --allow-env server.ts",
    "check": "deno check server.ts scripts/build-worklist.mjs scripts/sync-gendn-links.mjs && python3 .claude/audit-demos.py --strict && deno task test-speech-transcripts && deno task test-conformance-runner && deno task check-duplicates",
    "test-speech-transcripts": "deno run --allow-read scripts/speech-transcript.test.mjs",
    "test-conformance-runner": "deno run --allow-read scripts/conformance-runner.test.mjs",
    "sync-gendn-links": "deno run --allow-read --allow-write --allow-net --allow-run scripts/sync-gendn-links.mjs",
    "worklist": "deno run --allow-read --allow-write --allow-net --allow-run --allow-env scripts/build-worklist.mjs",
    "audit": "python3 .claude/audit-demos.py",
    "auto-research": "deno run --allow-run --allow-read --allow-write --allow-net --allow-env tools/auto-research.ts",
    "route-manifest": "deno run --allow-read --allow-run --allow-env scripts/route-manifest.mjs",
    "check-routes": "deno run --allow-read --allow-run --allow-env scripts/check-routes.mjs",
    "drive": "deno run --allow-read --allow-write --allow-run --allow-net --allow-env scripts/drive-demos.mjs",
    "check-duplicates": "deno run --allow-read scripts/check-duplicate-features.mjs && deno run --allow-read --allow-write scripts/apply-feature-lineage.mjs --check",
    "feature-lineage": "deno run --allow-read --allow-write --allow-net --allow-env scripts/build-feature-lineage.mjs",
    "apply-lineage": "deno run --allow-read --allow-write scripts/apply-feature-lineage.mjs",
    "responsive-support": "deno run --allow-read --allow-write --allow-run --allow-env scripts/responsive-support.mjs",
    "responsive-check": "deno run --allow-read --allow-write --allow-run --allow-net --allow-env scripts/responsive-check.mjs",
    "overflow-scan": "deno run --allow-read --allow-write --allow-run --allow-net --allow-env scripts/overflow-scan.mjs",
    "fmt": "deno fmt"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false,
    "semiColons": true,
    "exclude": ["**/*.html", "**/*.css", "v[0-9]*/**/*.js", "v[0-9]*/**/*.json"]
  },
  "compilerOptions": {
    "lib": ["deno.window", "dom"],
    "strict": true
  }
}
