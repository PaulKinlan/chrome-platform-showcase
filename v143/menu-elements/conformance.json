  "author": "claude-opus-5-v143-build",
  "assertions": [
    {
      "id": "menuitem-has-its-own-interface",
      "description": "The element exists as an element rather than as an unknown tag. HTMLUnknownElement is what every browser produces for a tag it has never heard of, so this is the difference between an implementation and a parse.",
      "kind": "script",
      "test": "(()=>{try{return document.createElement('menuitem').constructor.name==='HTMLMenuItemElement';}catch(e){return false;}})()",
      "specSection": "https://github.com/whatwg/html/pull/12011"
    },
    {
      "id": "menulist-and-menubar-have-their-own-interfaces",
      "description": "Both containers are real elements too, even though neither carries any IDL of its own — their behaviour is layout, top-layer participation and accessibility mapping.",
      "kind": "script",
      "test": "(()=>{try{return document.createElement('menulist').constructor.name==='HTMLMenuListElement'&&document.createElement('menubar').constructor.name==='HTMLMenuBarElement';}catch(e){return false;}})()",
      "specSection": "https://github.com/whatwg/html/pull/12011"
    },
    {
      "id": "menulist-is-hidden-until-invoked",
      "description": "A menulist sits inline in the markup beside the title that opens it, so the user-agent stylesheet must hide it. Anything other than display:none would mean every menu on the page is visible at load.",
      "kind": "script",
      "test": "(()=>{try{const h=document.createElement('div');h.style.cssText='position:absolute;left:-10000px';const m=document.createElement('menulist');h.append(m);document.body.append(h);const d=getComputedStyle(m).display;h.remove();return d==='none';}catch(e){return false;}})()",
      "specSection": "https://github.com/whatwg/html/pull/12011"
    },
    {
      "id": "menuitem-reflects-command-and-commandfor",
      "description": "A menu item invokes through the invoker command attributes rather than a click handler, and commandfor reflects as an element reference — which only resolves inside a document.",
      "kind": "script",
      "test": "(()=>{try{const h=document.createElement('div');h.style.cssText='position:absolute;left:-10000px';const i=document.createElement('menuitem');i.setAttribute('command','toggle-menu');i.setAttribute('commandfor','conf-target');const t=document.createElement('div');t.id='conf-target';h.append(i,t);document.body.append(h);const ok=i.command==='toggle-menu'&&i.commandForElement===t;h.remove();return ok;}catch(e){return false;}})()",
      "specSection": "https://github.com/whatwg/html/pull/12011"
    },
    {
      "id": "unknown-commands-reflect-as-the-empty-string",
      "description": "command is an enumerated attribute, so a keyword it does not know reads back as the empty string. That is what makes the reflection a per-keyword support probe rather than an all-or-nothing one.",
      "kind": "script",
      "test": "(()=>{try{const i=document.createElement('menuitem');if(!('command' in i))return false;i.setAttribute('command','open-menu');return i.command==='';}catch(e){return false;}})()",
      "specSection": "https://html.spec.whatwg.org/multipage/form-elements.html#attr-button-command"
    },
    {
      "id": "custom-commands-need-two-dashes",
      "description": "A name beginning with two dashes is passed through verbatim; the same name without them is reserved for the platform and is discarded. Without that rule an application's command could collide with a future built-in.",
      "kind": "script",
      "test": "(()=>{try{const i=document.createElement('menuitem');if(!('command' in i))return false;i.setAttribute('command','--app-thing');const custom=i.command==='--app-thing';i.setAttribute('command','app-thing');return custom&&i.command==='';}catch(e){return false;}})()",
      "specSection": "https://html.spec.whatwg.org/multipage/form-elements.html#attr-button-command"
    },
    {
      "id": "invoking-a-menuitem-opens-its-menulist",
      "description": "The whole markup-only claim in one check: a menuitem carrying command=toggle-menu opens the menulist it points at, and the opened menulist is in the top layer — matched by :popover-open, with no popover attribute anywhere.",
      "kind": "script",
      "test": "(()=>{try{const h=document.createElement('div');h.style.cssText='position:absolute;left:-10000px';h.innerHTML='<menubar><menuitem id=\"conf-title\" command=\"toggle-menu\" commandfor=\"conf-menu\">T</menuitem><menulist id=\"conf-menu\"><menuitem>One</menuitem></menulist></menubar>';document.body.append(h);const title=h.querySelector('#conf-title');const menu=h.querySelector('#conf-menu');title.click();const open=menu.matches(':popover-open');h.remove();return open;}catch(e){return false;}})()",
      "specSection": "https://github.com/whatwg/html/pull/12011"
    }
  ]
}
