{
  "release": "v154",
  "featureSlug": "fontface-width-attribute-and-font-width-descriptor",
  "chromestatusId": 5145402365050880,
  "specUrl": "https://drafts.csswg.org/css-fonts-4/#font-width-prop",
  "generatedAt": "2026-08-28T04:50:00Z",
  "author": "claude-opus-5-v154-build",
  "assertions": [
    {
      "id": "font-stretch-still-parses",
      "description": "The control: the original name must keep working. This is an alias, not a replacement.",
      "kind": "script",
      "test": "CSS.supports('font-stretch', '75%')",
      "specSection": "https://drafts.csswg.org/css-fonts-4/#font-stretch-prop"
    },
    {
      "id": "font-width-parses",
      "description": "The new property name is accepted by the parser.",
      "kind": "script",
      "test": "CSS.supports('font-width', '75%')",
      "specSection": "https://drafts.csswg.org/css-fonts-4/#font-width-prop"
    },
    {
      "id": "font-width-accepts-keywords",
      "description": "The keyword ladder survives the rename in both directions of the scale.",
      "kind": "script",
      "test": "CSS.supports('font-width', 'ultra-condensed') && CSS.supports('font-width', 'ultra-expanded')",
      "specSection": "https://drafts.csswg.org/css-fonts-4/#font-width-prop"
    },
    {
      "id": "font-width-changes-computed-font-stretch",
      "description": "Parsing is not applying. Setting font-width must change the computed font-stretch of a real element, which is what proves the two names address one property rather than two that happen to parse.",
      "kind": "script",
      "test": "(()=>{if(!CSS.supports('font-width','75%'))return false;const el=document.createElement('span');el.style.cssText='position:absolute;visibility:hidden';el.style.setProperty('font-width','75%');document.body.append(el);const value=getComputedStyle(el).fontStretch.trim();el.remove();return value==='75%';})()",
      "specSection": "https://drafts.csswg.org/css-fonts-4/#font-width-prop"
    },
    {
      "id": "fontface-width-aliases-stretch",
      "description": "Constructing a FontFace with a width descriptor must be readable through stretch. A one-way mapping would be worse than none, so both directions are asserted.",
      "kind": "script",
      "test": "(()=>{try{const a=new FontFace('AliasConf','url(about:invalid)',{width:'75%'});const b=new FontFace('AliasConf','url(about:invalid)',{stretch:'125%'});return a.stretch==='75%'&&b.width==='125%';}catch(e){return false;}})()",
      "specSection": "https://drafts.csswg.org/css-font-loading-3/#dom-fontface-width"
    },
    {
      "id": "fontface-width-assignment-propagates",
      "description": "Assignment must propagate too, not just construction — otherwise `face.width = x` silently creates an expando that nothing reads.",
      "kind": "script",
      "test": "(()=>{try{const f=new FontFace('AliasConf2','url(about:invalid)',{});f.width='125%';const forward=f.stretch==='125%';f.stretch='75%';const back=f.width==='75%';return forward&&back;}catch(e){return false;}})()",
      "specSection": "https://drafts.csswg.org/css-font-loading-3/#dom-fontface-width"
    },
    {
      "id": "negative-width-rejected",
      "description": "A negative width is meaningless and must not parse. Renaming a property must not loosen its grammar.",
      "kind": "script",
      "test": "CSS.supports('font-width', '-10%') === false",
      "specSection": "https://drafts.csswg.org/css-fonts-4/#font-width-prop"
    }
  ]
}
