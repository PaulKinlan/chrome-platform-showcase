  "assertions": [
    {
      "id": "webhid-is-present",
      "description": "navigator.hid exists. This is the capability check, and it is the only one of the three questions these demos ask that decides whether any code can run.",
      "kind": "script",
      "test": "(()=>{try{return typeof navigator.hid==='object'&&navigator.hid!==null;}catch(e){return false;}})()",
      "specSection": "https://wicg.github.io/webhid/index.html#navigator-interface"
    },
    {
      "id": "hid-exposes-getdevices-and-requestdevice",
      "description": "The two entry points, one of which needs a gesture and one of which does not. A page that cannot tell them apart will call the wrong one at load.",
      "kind": "script",
      "test": "(()=>{try{return typeof navigator.hid.getDevices==='function'&&typeof navigator.hid.requestDevice==='function';}catch(e){return false;}})()",
      "specSection": "https://wicg.github.io/webhid/index.html#hid-interface"
    },
    {
      "id": "hiddevice-carries-the-full-report-surface",
      "description": "Identity, collections, both report directions and the ability to hand the permission back. A specialised device needs all of it — a headset's mute button arrives as an input report and its LED is set with an output one.",
      "kind": "script",
      "test": "(()=>{try{const names=Object.getOwnPropertyNames(HIDDevice.prototype);return ['open','close','forget','sendReport','sendFeatureReport','receiveFeatureReport','collections','vendorId','productId','oninputreport'].every((n)=>names.includes(n));}catch(e){return false;}})()",
      "specSection": "https://wicg.github.io/webhid/index.html#hiddevice-interface"
    },
    {
      "id": "getdevices-needs-no-gesture-and-returns-a-list",
      "description": "The one call a page can make on load. It returns only already-permitted devices, so an empty array is the normal answer and must not be treated as a capability failure.",
      "kind": "script",
      "test": "(async()=>{try{const devices=await navigator.hid.getDevices();return Array.isArray(devices);}catch(e){return false;}})()",
      "specSection": "https://wicg.github.io/webhid/index.html#dom-hid-getdevices"
    },
    {
      "id": "requestdevice-requires-transient-activation",
      "description": "Called without a user gesture it must reject rather than showing a chooser. This is the first thing anyone hits, and the reason a page offers a button instead of asking on load.",
      "kind": "script",
      "test": "(async()=>{try{await navigator.hid.requestDevice({filters:[]});return false;}catch(e){return e.name==='SecurityError'||e.name==='NotAllowedError';}})()",
      "specSection": "https://wicg.github.io/webhid/index.html#dom-hid-requestdevice"
    },
    {
      "id": "the-platform-is-readable-separately-from-the-capability",
      "description": "This feature is about a platform, so a demo has to be able to say which platform it is on — and to keep that separate from whether the API exists. User-agent client hints are the supported way to ask.",
      "kind": "script",
      "test": "(()=>{try{return typeof navigator.userAgentData==='object'&&navigator.userAgentData!==null&&typeof navigator.userAgentData.mobile==='boolean'&&typeof navigator.userAgentData.getHighEntropyValues==='function';}catch(e){return false;}})()",
      "specSection": "https://wicg.github.io/ua-client-hints/"
    }
  ]
