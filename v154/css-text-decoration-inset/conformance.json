      "id": "length-value-parses",
      "description": "A single length is accepted and insets both ends.",
      "kind": "script",
      "test": "CSS.supports('text-decoration-inset', '4px')",
      "specSection": "https://drafts.csswg.org/css-text-decor-4/#propdef-text-decoration-inset"
    },
    {
      "id": "percentage-value-parses",
      "description": "A percentage is accepted, resolving against the text run — which is what makes a 100%-to-0 reveal expressible.",
      "kind": "script",
      "test": "CSS.supports('text-decoration-inset', '50%')",
      "specSection": "https://drafts.csswg.org/css-text-decor-4/#propdef-text-decoration-inset"
    },
    {
      "id": "auto-value-parses",
      "description": "auto is accepted and is the initial value.",
      "kind": "script",
      "test": "CSS.supports('text-decoration-inset', 'auto')",
      "specSection": "https://drafts.csswg.org/css-text-decor-4/#propdef-text-decoration-inset"
    },
    {
      "id": "two-value-syntax-parses",
      "description": "Two values set the start and end insets independently.",
      "kind": "script",
      "test": "CSS.supports('text-decoration-inset', '100% 0') && CSS.supports('text-decoration-inset', '4px 12px')",
      "specSection": "https://drafts.csswg.org/css-text-decor-4/#propdef-text-decoration-inset"
    },
    {
      "id": "negative-values-parse",
      "description": "A negative inset extends the line beyond the text rather than being clamped away. Rejecting it would remove the only way to draw a decoration wider than its run.",
      "kind": "script",
      "test": "CSS.supports('text-decoration-inset', '-6px')",
      "specSection": "https://drafts.csswg.org/css-text-decor-4/#propdef-text-decoration-inset"
    },
    {
      "id": "initial-value-is-auto",
      "description": "An element with no author value computes to auto, so adding the property to a stylesheet cannot change text that does not opt in.",
      "kind": "script",
      "test": "(()=>{if(!CSS.supports('text-decoration-inset','4px'))return false;const el=document.createElement('span');el.style.cssText='position:absolute;visibility:hidden';document.body.append(el);const value=getComputedStyle(el).getPropertyValue('text-decoration-inset').trim();el.remove();return value==='auto';})()",
      "specSection": "https://drafts.csswg.org/css-text-decor-4/#propdef-text-decoration-inset"
    },
    {
      "id": "one-value-expands-to-both-ends",
      "description": "A single value must apply to both the start and the end. Reading the computed value back is what distinguishes a real shorthand expansion from a parse that kept only one side.",
      "kind": "script",
      "test": "(()=>{if(!CSS.supports('text-decoration-inset','6px'))return false;const el=document.createElement('span');el.style.cssText='position:absolute;visibility:hidden';el.style.setProperty('text-decoration-inset','6px');document.body.append(el);const value=getComputedStyle(el).getPropertyValue('text-decoration-inset').trim();el.remove();return value==='6px'||value==='6px 6px';})()",
      "specSection": "https://drafts.csswg.org/css-text-decor-4/#propdef-text-decoration-inset"
    },
    {
      "id": "is-animatable",
      "description": "The reveal effect depends on the property being interpolable, not merely settable. Registering an animation and sampling it mid-flight is the only way to confirm it animates rather than steps.",
      "kind": "script",
      "test": "(()=>{if(!CSS.supports('text-decoration-inset','0px'))return false;const el=document.createElement('span');el.style.cssText='position:absolute;visibility:hidden';el.textContent='sample';document.body.append(el);let ok=false;try{const anim=el.animate([{textDecorationInset:'0px'},{textDecorationInset:'40px'}],{duration:1000,fill:'both'});anim.currentTime=500;const mid=getComputedStyle(el).getPropertyValue('text-decoration-inset').trim();anim.cancel();ok=mid!=='0px'&&mid!=='40px'&&mid!=='';}catch(e){ok=false;}el.remove();return ok;})()",
      "specSection": "https://drafts.csswg.org/css-text-decor-4/#propdef-text-decoration-inset"
    }
  ]
