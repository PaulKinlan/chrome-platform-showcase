{
  "release": "v154",
  "featureSlug": "css-symbols",
  "chromestatusId": 5146996093616128,
  "specUrl": "https://drafts.csswg.org/css-counter-styles-3/#symbols-function",
  "generatedAt": "2026-08-28T02:40:00Z",
  "author": "claude-opus-5-v154-build",
  "assertions": [
    {
      "id": "symbols-parses-in-list-style-type",
      "description": "symbols() is accepted as a counter style in list-style-type.",
      "kind": "script",
      "test": "CSS.supports('list-style-type', 'symbols(\"*\" \"+\")')",
      "specSection": "https://drafts.csswg.org/css-counter-styles-3/#symbols-function"
    },
    {
      "id": "symbols-defaults-to-cyclic",
      "description": "The system is optional and defaults to cyclic, so a bare symbols() list is valid.",
      "kind": "script",
      "test": "CSS.supports('list-style-type', 'symbols(\"a\")')",
      "specSection": "https://drafts.csswg.org/css-counter-styles-3/#symbols-function"
    },
    {
      "id": "all-five-systems-parse",
      "description": "cyclic, numeric, alphabetic, symbolic and fixed are all accepted, each with two symbols so the positional ones are valid.",
      "kind": "script",
      "test": "['cyclic','numeric','alphabetic','symbolic','fixed'].every((s)=>CSS.supports('list-style-type', 'symbols('+s+' \"a\" \"b\")'))",
      "specSection": "https://drafts.csswg.org/css-counter-styles-3/#symbols-function"
    },
    {
      "id": "positional-systems-require-two-symbols",
      "description": "numeric and alphabetic are positional and cannot count with a single symbol, so a one-symbol list must be rejected. Accepting it would produce a counter that never advances.",
      "kind": "script",
      "test": "CSS.supports('list-style-type', 'symbols(numeric \"a\")') === false && CSS.supports('list-style-type', 'symbols(alphabetic \"a\")') === false",
      "specSection": "https://drafts.csswg.org/css-counter-styles-3/#symbols-function"
    },
    {
      "id": "symbols-parses-in-the-list-style-shorthand",
      "description": "The shorthand accepts it too, not only the longhand.",
      "kind": "script",
      "test": "CSS.supports('list-style', 'symbols(\"*\" \"+\") inside')",
      "specSection": "https://drafts.csswg.org/css-lists-3/#list-style-property"
    },
    {
      "id": "symbols-parses-inside-counter",
      "description": "counter() accepts symbols() as its counter style, which is what allows generated content to use an inline style.",
      "kind": "script",
      "test": "CSS.supports('content', 'counter(x, symbols(\"a\" \"b\"))')",
      "specSection": "https://drafts.csswg.org/css-lists-3/#counter-functions"
    },
    {
      "id": "symbols-parses-inside-counters",
      "description": "counters() — the nesting-aware form — accepts it as well, so a whole outline can be numbered inline.",
      "kind": "script",
      "test": "CSS.supports('content', 'counters(x, \".\", symbols(alphabetic \"a\" \"b\"))')",
      "specSection": "https://drafts.csswg.org/css-lists-3/#counter-functions"
    },
    {
      "id": "symbols-actually-marks-a-list",
      "description": "Parsing is not rendering. An element with a symbols() list-style-type must report it in the computed style, which is what proves the value survived to used-value time rather than being dropped.",
      "kind": "script",
      "test": "(()=>{if(!CSS.supports('list-style-type','symbols(\"a\" \"b\")'))return false;const el=document.createElement('ol');el.style.cssText='position:absolute;visibility:hidden';el.style.listStyleType='symbols(\"a\" \"b\")';document.body.append(el);const value=getComputedStyle(el).listStyleType;el.remove();return value.includes('symbols');})()",
      "specSection": "https://drafts.csswg.org/css-counter-styles-3/#symbols-function"
    }
  ]
}
