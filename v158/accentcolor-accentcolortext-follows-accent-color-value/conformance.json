  "assertions": [
    {
      "id": "accentcolor-keyword-parses",
      "description": "The AccentColor system color keyword parses as a <color> value.",
      "kind": "css-supports",
      "test": "color: AccentColor",
      "specSection": "https://www.w3.org/TR/css-color-4/#css-system-colors",
      "expectedBrowsers": ["firefox", "safari"]
    },
    {
      "id": "accentcolortext-keyword-parses",
      "description": "The AccentColorText system color keyword parses as a <color> value.",
      "kind": "css-supports",
      "test": "color: AccentColorText",
      "specSection": "https://www.w3.org/TR/css-color-4/#css-system-colors",
      "expectedBrowsers": ["firefox", "safari"]
    },
    {
      "id": "accentcolor-mirrors-own-accent-color",
      "description": "AccentColor resolves to the element's own computed accent-color value, not a static system accent.",
      "kind": "script",
      "test": "(()=>{if(!CSS.supports('color','AccentColor'))return false;const el=document.createElement('div');el.style.cssText='position:absolute;visibility:hidden;';el.style.accentColor='rgb(11, 22, 33)';el.style.backgroundColor='AccentColor';document.body.appendChild(el);const v=getComputedStyle(el).backgroundColor;el.remove();return v==='rgb(11, 22, 33)';})()",
      "specSection": "https://www.w3.org/TR/css-color-4/#css-system-colors"
    },
    {
      "id": "accentcolor-mirrors-inherited-accent-color",
      "description": "AccentColor on a descendant resolves against the accent-color it inherited from an ancestor.",
      "kind": "script",
      "test": "(()=>{if(!CSS.supports('color','AccentColor'))return false;const p=document.createElement('div');p.style.cssText='position:absolute;visibility:hidden;';p.style.accentColor='rgb(1, 2, 3)';const c=document.createElement('div');c.style.backgroundColor='AccentColor';p.appendChild(c);document.body.appendChild(p);const v=getComputedStyle(c).backgroundColor;p.remove();return v==='rgb(1, 2, 3)';})()",
      "specSection": "https://www.w3.org/TR/css-color-4/#css-system-colors"
    },
    {
      "id": "accentcolor-updates-when-accent-color-changes",
      "description": "A later change to accent-color is reflected by AccentColor on re-resolution (two successive values resolve to two different colors).",
      "kind": "script",
      "test": "(()=>{if(!CSS.supports('color','AccentColor'))return false;const el=document.createElement('div');el.style.cssText='position:absolute;visibility:hidden;';el.style.backgroundColor='AccentColor';document.body.appendChild(el);el.style.accentColor='rgb(4, 5, 6)';const v1=getComputedStyle(el).backgroundColor;el.style.accentColor='rgb(7, 8, 9)';const v2=getComputedStyle(el).backgroundColor;el.remove();return v1==='rgb(4, 5, 6)'&&v2==='rgb(7, 8, 9)';})()",
      "specSection": "https://www.w3.org/TR/css-color-4/#css-system-colors"
    },
    {
      "id": "accentcolortext-contrasts-light-accent",
      "description": "AccentColorText resolves to black against light accents (rgb(255,165,0) and rgb(245,245,245)), per the WPT expectations.",
      "kind": "script",
      "test": "(()=>{if(!CSS.supports('color','AccentColorText'))return false;const el=document.createElement('div');el.style.cssText='position:absolute;visibility:hidden;';el.style.color='AccentColorText';document.body.appendChild(el);el.style.accentColor='rgb(255, 165, 0)';const v1=getComputedStyle(el).color;el.style.accentColor='rgb(245, 245, 245)';const v2=getComputedStyle(el).color;el.remove();return v1==='rgb(0, 0, 0)'&&v2==='rgb(0, 0, 0)';})()",
      "specSection": "https://drafts.csswg.org/css-ui-4/#widget-accent"
    },
    {
      "id": "accentcolortext-contrasts-dark-accent",
      "description": "AccentColorText resolves to white against a near-black accent (rgb(10,10,10)), per the WPT expectations.",
      "kind": "script",
      "test": "(()=>{if(!CSS.supports('color','AccentColorText'))return false;const el=document.createElement('div');el.style.cssText='position:absolute;visibility:hidden;';el.style.accentColor='rgb(10, 10, 10)';el.style.color='AccentColorText';document.body.appendChild(el);const v=getComputedStyle(el).color;el.remove();return v==='rgb(255, 255, 255)';})()",
      "specSection": "https://drafts.csswg.org/css-ui-4/#widget-accent"
    },
    {
      "id": "accent-color-accentcolor-cycle-breaks-to-parent",
      "description": "accent-color: AccentColor on a child resolves to the parent's accent-color instead of forming a cycle.",
      "kind": "script",
      "test": "(()=>{if(!CSS.supports('color','AccentColor'))return false;const p=document.createElement('div');p.style.cssText='position:absolute;visibility:hidden;';p.style.accentColor='rgb(20, 40, 60)';const c=document.createElement('div');c.style.accentColor='AccentColor';c.style.backgroundColor='AccentColor';p.appendChild(c);document.body.appendChild(p);const v=getComputedStyle(c).backgroundColor;p.remove();return v==='rgb(20, 40, 60)';})()",
      "specSection": "https://drafts.csswg.org/css-ui-4/#widget-accent"
    },
    {
      "id": "accent-color-currentcolor-resolves-own-color",
      "description": "With accent-color: currentcolor, AccentColor mirrors the element's own used color value.",
      "kind": "script",
      "test": "(()=>{if(!CSS.supports('color','AccentColor'))return false;const el=document.createElement('div');el.style.cssText='position:absolute;visibility:hidden;';el.style.color='rgb(0, 128, 0)';el.style.accentColor='currentcolor';el.style.backgroundColor='AccentColor';document.body.appendChild(el);const v=getComputedStyle(el).backgroundColor;el.remove();return v==='rgb(0, 128, 0)';})()",
      "specSection": "https://drafts.csswg.org/css-ui-4/#widget-accent"
    },
    {
      "id": "forced-colors-overrides-accent-keywords",
      "description": "In forced-colors mode the forced palette, not accent-color, supplies AccentColor/AccentColorText (CSS Color 4: \"unless Forced Colors Mode is enabled\"). Requires forced-colors to be switched on by the user/OS, so it cannot run automatically here.",
      "kind": "manual",
      "test": "Enable forced colors (Windows High Contrast / chrome://flags#forced-colors emulation or DevTools rendering emulation), load any concept page, and verify the tiles take the forced palette rather than the authored accent-color.",
      "specSection": "https://www.w3.org/TR/css-color-4/#css-system-colors"
    }
  ]
