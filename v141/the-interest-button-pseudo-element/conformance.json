      "test": "(()=>{if(!CSS.supports('selector(::interest-button)'))return false;const a=document.createElement('a');a.href='#';a.setAttribute('interestfor','ib-conf-card');a.textContent='probe';const card=document.createElement('div');card.id='ib-conf-card';card.setAttribute('popover','');document.body.append(a,card);const s=new CSSStyleSheet();s.replaceSync('a[interestfor]::interest-button { padding: 7px; }');document.adoptedStyleSheets=[...document.adoptedStyleSheets,s];const pad=getComputedStyle(a,'::interest-button').paddingInlineStart;document.adoptedStyleSheets=document.adoptedStyleSheets.filter((x)=>x!==s);a.remove();card.remove();return pad==='7px';})()",
