      "kind": "script",
      "test": "(async()=>{const h=await import('/v159/serviceworker-static-routing-distinct-typeerror-message-for-cancelled-race-netwo/harness.js');const r=await h.run('fallback',{delay:800,fb:100});const f=r.worker.fetches&&r.worker.fetches[0];return !!f&&f.settled==='rejected'&&f.name==='TypeError';})()",
