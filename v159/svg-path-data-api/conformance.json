      "id": "svgpath-getpathdata-function",
      "description": "SVGPathElement.prototype.getPathData is a function.",
      "kind": "typeof",
      "test": "SVGPathElement.prototype.getPathData",
      "expect": "function",
      "specSection": "https://w3c.github.io/svgwg/specs/paths/#InterfaceSVGPathData"
    },
    {
      "id": "svgpath-setpathdata-function",
      "description": "SVGPathElement.prototype.setPathData is a function.",
      "kind": "typeof",
      "test": "SVGPathElement.prototype.setPathData",
      "expect": "function",
      "specSection": "https://w3c.github.io/svgwg/specs/paths/#InterfaceSVGPathData"
    },
    {
      "id": "svgpath-getpathsegmentatlength-function",
      "description": "SVGPathElement.prototype.getPathSegmentAtLength is a function.",
      "kind": "typeof",
      "test": "SVGPathElement.prototype.getPathSegmentAtLength",
      "expect": "function",
      "specSection": "https://w3c.github.io/svgwg/specs/paths/#InterfaceSVGPathData"
    },
    {
      "id": "svgpath-getpathdata-segment-shape",
      "description": "getPathData() on `M 10 20 L 30 40` returns two segments shaped {type, values}: M [10,20] then L [30,40].",
      "kind": "script",
      "test": "(()=>{if(typeof SVGPathElement.prototype.getPathData!=='function')return false;const p=document.createElementNS('http://www.w3.org/2000/svg','path');p.setAttribute('d','M 10 20 L 30 40');const s=Array.from(p.getPathData());return s.length===2&&s[0].type==='M'&&Array.from(s[0].values).join()==='10,20'&&s[1].type==='L'&&Array.from(s[1].values).join()==='30,40';})()",
      "specSection": "https://w3c.github.io/svgwg/specs/paths/#InterfaceSVGPathData"
    },
    {
      "id": "svgpath-getpathdata-normalize",
      "description": "getPathData({normalize:true}) reduces relative/shorthand/arc commands to absolute M, L, C and Z only.",
      "kind": "script",
      "test": "(()=>{if(typeof SVGPathElement.prototype.getPathData!=='function')return false;const p=document.createElementNS('http://www.w3.org/2000/svg','path');p.setAttribute('d','m 10 20 h 30 a 10 10 0 0 1 20 0 q 5 -10 10 0 z');const s=Array.from(p.getPathData({normalize:true}));return s.length>0&&s.every((seg)=>['M','L','C','Z'].includes(seg.type));})()",
      "specSection": "https://w3c.github.io/svgwg/specs/paths/#InterfaceSVGPathData"
    },
    {
      "id": "svgpath-setpathdata-roundtrip",
      "description": "setPathData() applied to a new array renders back through getPathData() with the written types and values.",
      "kind": "script",
      "test": "(()=>{if(typeof SVGPathElement.prototype.setPathData!=='function')return false;const p=document.createElementNS('http://www.w3.org/2000/svg','path');p.setPathData([{type:'M',values:[1,2]},{type:'L',values:[3,4]},{type:'Z',values:[]}]);const s=Array.from(p.getPathData());return s.length===3&&s[0].type==='M'&&s[1].type==='L'&&s[2].type==='Z'&&Array.from(s[1].values).join()==='3,4';})()",
      "specSection": "https://w3c.github.io/svgwg/specs/paths/#InterfaceSVGPathData"
    },
    {
      "id": "svgpath-segmentatlength-boundaries",
      "description": "getPathSegmentAtLength() returns a numeric index that never decreases along `M 0 0 L 10 0 L 10 10`, and clamps past the total length instead of throwing.",
      "kind": "script",
      "test": "(()=>{if(typeof SVGPathElement.prototype.getPathSegmentAtLength!=='function')return false;const p=document.createElementNS('http://www.w3.org/2000/svg','path');p.setAttribute('d','M 0 0 L 10 0 L 10 10');const a=p.getPathSegmentAtLength(0);const b=p.getPathSegmentAtLength(5);const c=p.getPathSegmentAtLength(15);const d=p.getPathSegmentAtLength(999);return [a,b,c,d].every((v)=>typeof v==='number')&&a<=b&&b<=c&&c<=d;})()",
      "specSection": "https://w3c.github.io/svgwg/specs/paths/#InterfaceSVGPathData"
    }
  ]
}
