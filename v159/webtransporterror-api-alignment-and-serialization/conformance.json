  "assertions": [
    {
      "id": "wte-constructor-exists",
      "description": "WebTransportError is a constructor.",
      "kind": "typeof",
      "test": "WebTransportError",
      "expect": "function",
      "specSection": "https://www.w3.org/TR/webtransport/#web-transport-error-interface"
    },
    {
      "id": "wte-standard-message-first",
      "description": "The standard (message, options) signature works: the message string lands in .message and options carry source and streamErrorCode.",
      "kind": "script",
      "test": "(()=>{if(typeof WebTransportError!=='function')return false;try{const e=new WebTransportError('m',{source:'stream',streamErrorCode:42});return e.message==='m'&&e.source==='stream'&&e.streamErrorCode===42;}catch(x){return false;}})()",
      "specSection": "https://www.w3.org/TR/webtransport/#web-transport-error-interface"
    },
    {
      "id": "wte-legacy-dictionary-compat",
      "description": "The shipped legacy dictionary constructor still works for compatibility: new WebTransportError({streamErrorCode}) constructs with that code.",
      "kind": "script",
      "test": "(()=>{if(typeof WebTransportError!=='function')return false;try{const e=new WebTransportError({streamErrorCode:7});return e.streamErrorCode===7&&e.name==='WebTransportError';}catch(x){return false;}})()",
      "specSection": "https://chromestatus.com/feature/5158277221580800"
    },
    {
      "id": "wte-full-unsigned-long-range",
      "description": "streamErrorCode carries the full unsigned-long range: 4294967295 reads back exactly, unclamped.",
      "kind": "script",
      "test": "(()=>{if(typeof WebTransportError!=='function')return false;let e;try{e=new WebTransportError('m',{source:'stream',streamErrorCode:4294967295});if(e.message!=='m')throw 0;}catch(x){e=new WebTransportError({streamErrorCode:4294967295});}return e.streamErrorCode===4294967295;})()",
      "specSection": "https://www.w3.org/TR/webtransport/#web-transport-error-interface"
    },
    {
      "id": "wte-default-code-null",
      "description": "streamErrorCode is nullable and defaults to null when not provided.",
      "kind": "script",
      "test": "(()=>{if(typeof WebTransportError!=='function')return false;const e=new WebTransportError();return e.streamErrorCode===null;})()",
      "specSection": "https://www.w3.org/TR/webtransport/#web-transport-error-interface"
    },
    {
      "id": "wte-structured-clonable",
      "description": "WebTransportError is structured-clonable: structuredClone preserves name, message, source and streamErrorCode.",
      "kind": "script",
      "test": "(()=>{if(typeof WebTransportError!=='function')return false;let e;try{e=new WebTransportError('m',{source:'stream',streamErrorCode:99});if(e.message!=='m')throw 0;}catch(x){e=new WebTransportError({message:'m',streamErrorCode:99});}try{const c=structuredClone(e);return c.name==='WebTransportError'&&c.message===e.message&&c.source===e.source&&c.streamErrorCode===99;}catch(x){return false;}})()",
      "specSection": "https://www.w3.org/TR/webtransport/#web-transport-error-interface"
    }
  ]
}
