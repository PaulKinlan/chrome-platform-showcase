{
  "release": "v152",
  "featureSlug": "single-axis-scroll-containers",
  "chromestatusId": 5067363861004288,
  "specUrl": "https://drafts.csswg.org/css-overflow-3/#overflow-control",
  "generatedAt": "2026-07-26T00:00:00Z",
  "author": "weekly-hardening-agent",
  "assertions": [
    {
      "id": "overflow-two-value-scroll-clip-parses",
      "description": "The overflow shorthand accepts the two-value form 'scroll clip' (this has parsed for years; the change is in computed-value handling, not parsing).",
      "kind": "css-supports",
      "test": "overflow: scroll clip",
      "specSection": "https://drafts.csswg.org/css-overflow-3/#propdef-overflow"
    },
    {
      "id": "shorthand-clip-preserved-next-to-scroll",
      "description": "overflow: scroll clip computes to overflow-y: clip instead of the legacy coercion to hidden — the core single-axis change. Fails honestly on Chrome 151 and earlier.",
      "kind": "script",
      "test": "(()=>{const e=document.createElement('div');e.style.cssText='position:absolute;visibility:hidden;width:10px;height:10px;';e.style.overflow='scroll clip';document.body.appendChild(e);const cs=getComputedStyle(e);const ok=cs.overflowX==='scroll'&&cs.overflowY==='clip';e.remove();return ok;})()",
      "specSection": "https://drafts.csswg.org/css-overflow-3/#overflow-control"
    },
    {
      "id": "longhand-clip-preserved-next-to-scroll",
      "description": "Setting the longhands overflow-x: scroll and overflow-y: clip separately also preserves the computed clip value. Fails honestly on Chrome 151 and earlier.",
      "kind": "script",
      "test": "(()=>{const e=document.createElement('div');e.style.cssText='position:absolute;visibility:hidden;width:10px;height:10px;overflow-x:scroll;overflow-y:clip;';document.body.appendChild(e);const v=getComputedStyle(e).overflowY;e.remove();return v==='clip';})()",
      "specSection": "https://drafts.csswg.org/css-overflow-3/#overflow-control"
    },
    {
      "id": "clip-axis-rejects-programmatic-scroll",
      "description": "In a scroll clip box with overflowing content, script cannot move the clip axis (scrollTop stays 0) while the scroll axis still moves — the single-axis scroll container behavior contract. Fails honestly where clip is coerced to hidden.",
      "kind": "script",
      "test": "(()=>{const c=document.createElement('div');c.style.cssText='position:absolute;left:-9999px;top:0;width:100px;height:100px;';c.style.overflow='scroll clip';const inner=document.createElement('div');inner.style.cssText='width:300px;height:300px;';c.appendChild(inner);document.body.appendChild(c);c.scrollTop=50;const pinned=c.scrollTop===0;c.scrollLeft=50;const xMoves=c.scrollLeft>0;c.remove();return pinned&&xMoves;})()",
      "specSection": "https://drafts.csswg.org/css-overflow-3/#single-axis-scroll-container"
    },
    {
      "id": "visible-still-coerces-to-auto",
      "description": "The unchanged companion rule: a specified visible computes to auto when the other axis has a scrollable value. Single-axis scroll containers did not relax this.",
      "kind": "script",
      "test": "(()=>{const e=document.createElement('div');e.style.cssText='position:absolute;visibility:hidden;width:10px;height:10px;';e.style.overflow='scroll visible';document.body.appendChild(e);const v=getComputedStyle(e).overflowY;e.remove();return v==='auto';})()",
      "specSection": "https://drafts.csswg.org/css-overflow-3/#overflow-control"
    },
    {
      "id": "hidden-remains-programmatically-scrollable",
      "description": "The contrast contract: overflow: scroll hidden leaves the hidden axis movable by script (scrollTop can leave 0), which is exactly the leak that clip fixes.",
      "kind": "script",
      "test": "(()=>{const c=document.createElement('div');c.style.cssText='position:absolute;left:-9999px;top:0;width:100px;height:100px;';c.style.overflow='scroll hidden';const inner=document.createElement('div');inner.style.cssText='width:300px;height:300px;';c.appendChild(inner);document.body.appendChild(c);c.scrollTop=50;const moved=c.scrollTop>0;c.remove();return moved;})()",
      "specSection": "https://drafts.csswg.org/css-overflow-3/#valdef-overflow-hidden"
    },
    {
      "id": "clip-visible-combination-preserved",
      "description": "clip and visible have always been allowed to combine: overflow: clip visible keeps both computed values as specified and the box is not a scroll container.",
      "kind": "script",
      "test": "(()=>{const e=document.createElement('div');e.style.cssText='position:absolute;visibility:hidden;width:10px;height:10px;';e.style.overflow='clip visible';document.body.appendChild(e);const cs=getComputedStyle(e);const ok=cs.overflowX==='clip'&&cs.overflowY==='visible';e.remove();return ok;})()",
      "specSection": "https://drafts.csswg.org/css-overflow-3/#overflow-control"
    },
    {
      "id": "clip-clip-is-not-a-scroll-container",
      "description": "overflow: clip clip produces no scroll container: neither axis can be moved by script even with overflowing content.",
      "kind": "script",
      "test": "(()=>{const c=document.createElement('div');c.style.cssText='position:absolute;left:-9999px;top:0;width:100px;height:100px;';c.style.overflow='clip clip';const inner=document.createElement('div');inner.style.cssText='width:300px;height:300px;';c.appendChild(inner);document.body.appendChild(c);c.scrollTop=50;c.scrollLeft=50;const pinned=c.scrollTop===0&&c.scrollLeft===0;c.remove();return pinned;})()",
      "specSection": "https://drafts.csswg.org/css-overflow-3/#valdef-overflow-clip"
    }
  ]
}
