  "assertions": [
    {
      "id": "decodinginfo-exists",
      "description": "navigator.mediaCapabilities.decodingInfo is a function.",
      "kind": "typeof",
      "test": "navigator.mediaCapabilities.decodingInfo",
      "expect": "function",
      "specSection": "https://www.w3.org/TR/media-capabilities/#dom-mediacapabilities-decodinginfo"
    },
    {
      "id": "clear-result-shape",
      "description": "A clear (unencrypted) decodingInfo() result carries boolean supported/smooth/powerEfficient and keySystemAccess: null.",
      "kind": "script",
      "test": "(async()=>{const r=await navigator.mediaCapabilities.decodingInfo({type:'media-source',video:{contentType:'video/webm; codecs=\"vp09.00.10.08\"',width:1280,height:720,bitrate:2500000,framerate:30}});return typeof r.supported==='boolean'&&typeof r.smooth==='boolean'&&typeof r.powerEfficient==='boolean'&&('keySystemAccess' in r)&&r.keySystemAccess===null;})()",
      "specSection": "https://www.w3.org/TR/media-capabilities/#media-capabilities-info"
    },
    {
      "id": "unrecognized-scheme-unsupported",
      "description": "With ClearKey available, encryptionScheme: null reports supported while an unrecognized scheme string must report supported: false (the Chrome 152 contract; a browser that drops the member fails this).",
      "kind": "script",
      "test": "(async()=>{const cfg=(s)=>({type:'media-source',video:{contentType:'video/webm; codecs=\"vp09.00.10.08\"',width:1280,height:720,bitrate:2500000,framerate:30},keySystemConfiguration:{keySystem:'org.w3.clearkey',initDataType:'keyids',video:{robustness:'',encryptionScheme:s}}});const nul=await navigator.mediaCapabilities.decodingInfo(cfg(null));const bogus=await navigator.mediaCapabilities.decodingInfo(cfg('x-conformance-bogus'));return nul.supported===true&&bogus.supported===false;})()",
      "specSection": "https://w3c.github.io/encrypted-media/#dom-mediakeysystemmediacapability-encryptionscheme"
    },
    {
      "id": "empty-string-scheme-distinct-from-null",
      "description": "The empty string is a distinct, unrecognized encryptionScheme (not an alias for null): with ClearKey available, null reports supported while '' must not.",
      "kind": "script",
      "test": "(async()=>{const cfg=(s)=>({type:'media-source',video:{contentType:'video/webm; codecs=\"vp09.00.10.08\"',width:1280,height:720,bitrate:2500000,framerate:30},keySystemConfiguration:{keySystem:'org.w3.clearkey',initDataType:'keyids',video:{robustness:'',encryptionScheme:s}}});const nul=await navigator.mediaCapabilities.decodingInfo(cfg(null));const empty=await navigator.mediaCapabilities.decodingInfo(cfg(''));return nul.supported===true&&empty.supported===false;})()",
      "specSection": "https://w3c.github.io/encrypted-media/#dom-mediakeysystemmediacapability-encryptionscheme"
    },
    {
      "id": "supported-couples-keysystemaccess",
      "description": "For an encrypted query, keySystemAccess is a real MediaKeySystemAccess exactly when supported is true, and null when it is false.",
      "kind": "script",
      "test": "(async()=>{const r=await navigator.mediaCapabilities.decodingInfo({type:'media-source',video:{contentType:'video/webm; codecs=\"vp09.00.10.08\"',width:1280,height:720,bitrate:2500000,framerate:30},keySystemConfiguration:{keySystem:'org.w3.clearkey',initDataType:'keyids',video:{robustness:'',encryptionScheme:'cenc'}}});return r.supported?(r.keySystemAccess!==null&&typeof r.keySystemAccess.createMediaKeys==='function'):r.keySystemAccess===null;})()",
      "specSection": "https://www.w3.org/TR/media-capabilities/#check-encrypted-decoding-support"
    },
    {
      "id": "reject-no-tracks",
      "description": "decodingInfo() rejects with TypeError when the configuration has neither audio nor video.",
      "kind": "throws",
      "test": "navigator.mediaCapabilities.decodingInfo({type:'media-source'})",
      "specSection": "https://www.w3.org/TR/media-capabilities/#decodinginfo-method"
    },
    {
      "id": "reject-webrtc-with-keysystem",
      "description": "decodingInfo() rejects with TypeError when keySystemConfiguration is present but type is 'webrtc' (must be media-source or file).",
      "kind": "throws",
      "test": "navigator.mediaCapabilities.decodingInfo({type:'webrtc',video:{contentType:'video/VP8',width:640,height:360,bitrate:800000,framerate:30},keySystemConfiguration:{keySystem:'org.w3.clearkey'}})",
      "specSection": "https://www.w3.org/TR/media-capabilities/#valid-mediadecodingconfiguration"
    },
    {
      "id": "reject-malformed-mime",
      "description": "decodingInfo() rejects with TypeError when video.contentType is not a valid MIME type ('video' has no subtype).",
      "kind": "throws",
      "test": "navigator.mediaCapabilities.decodingInfo({type:'media-source',video:{contentType:'video',width:1280,height:720,bitrate:2500000,framerate:30}})",
      "specSection": "https://www.w3.org/TR/media-capabilities/#check-mime-type-validity"
    }
  ]
