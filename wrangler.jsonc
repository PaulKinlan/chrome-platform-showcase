// Cloudflare Workers config for chrome-platform-showcase.
// How it fits together, how to deploy, and what to set up: docs/cloudflare.md.
{
  "name": "chrome-platform-showcase",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",

  // Stages demo files into dist/worker-assets before every `wrangler dev`,
  // `wrangler deploy` and Workers Builds run.
  "build": {
    "command": "node scripts/build-worker-assets.mjs"
  },

  "assets": {
    "directory": "dist/worker-assets",
    "binding": "ASSETS",
    // Every request goes through the Worker: demo HTML is rewritten on the way
    // out (breadcrumbs, conformance panel, telemetry), and internal files
    // (conformance.json, _questions.json, the fs manifest) are only served
    // where a route chooses to.
    "run_worker_first": true,
    // The Worker asks for exact file paths; no index.html or 404 rewriting.
    "html_handling": "none",
    "not_found_handling": "none"
  },

  "observability": {
    "enabled": true
  },

  // Telemetry + Reporting API storage (routes/demo-telemetry.ts, the v151 DPO
  // sidecar) through worker/d1.ts. Schema lives in migrations/; apply with
  // `npx wrangler d1 migrations apply chrome-platform-showcase --remote`.
  // Without this binding telemetry is accepted but kept only in memory, the
  // same as a Deno host without KV.
  "d1_databases": [
    {
      "binding": "SHOWCASE_DB",
      "database_name": "chrome-platform-showcase",
      "database_id": "2dffbc24-47fd-4846-a4b2-86ac80934c8d",
      "migrations_dir": "migrations"
    }
  ]
  // Secret (never in this file): `npx wrangler secret put showcase_password`
}
