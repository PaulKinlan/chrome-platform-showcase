  "assertions": [
    {
      "id": "scroll-axis-lock-none-parses",
      "description": "The keyword that carries the feature: the user agent must not lock scrolls on the element to one axis.",
      "kind": "css-supports",
      "test": "scroll-axis-lock: none",
      "specSection": "https://github.com/w3c/csswg-drafts/pull/14152"
    },
    {
      "id": "scroll-axis-lock-auto-parses",
      "description": "The initial value: the user agent may lock. Permission rather than a promise, which is why device behaviour still varies under it.",
      "kind": "css-supports",
      "test": "scroll-axis-lock: auto",
      "specSection": "https://github.com/w3c/csswg-drafts/pull/14152"
    },
    {
      "id": "invalid-keywords-are-rejected",
      "description": "The grammar is auto | none and nothing else. A browser that accepts an invented keyword is not parsing the property, and a support check that only tests a valid value cannot tell the difference.",
      "kind": "script",
      "test": "(()=>{try{return !CSS.supports('scroll-axis-lock','sideways')&&!CSS.supports('scroll-axis-lock','x')&&!CSS.supports('scroll-axis-lock','both');}catch(e){return false;}})()",
      "specSection": "https://github.com/w3c/csswg-drafts/pull/14152"
    },
    {
      "id": "initial-value-is-auto",
      "description": "A scroll container that says nothing must compute to auto, so adopting the property is opt-in and no existing scroller changes behaviour.",
      "kind": "script",
      "test": "(()=>{try{if(!CSS.supports('scroll-axis-lock','none'))return false;const b=document.createElement('div');b.style.cssText='position:absolute;left:-10000px;width:100px;height:100px;overflow:auto';document.body.append(b);const v=getComputedStyle(b).getPropertyValue('scroll-axis-lock');b.remove();return v==='auto';}catch(e){return false;}})()",
      "specSection": "https://github.com/w3c/csswg-drafts/pull/14152"
    },
    {
      "id": "the-declared-value-round-trips",
      "description": "Declaring none on a scroll container must compute to none. Anything else would mean the declaration was parsed and then discarded.",
      "kind": "script",
      "test": "(()=>{try{if(!CSS.supports('scroll-axis-lock','none'))return false;const b=document.createElement('div');b.style.cssText='position:absolute;left:-10000px;width:100px;height:100px;overflow:auto;scroll-axis-lock:none';document.body.append(b);const v=getComputedStyle(b).getPropertyValue('scroll-axis-lock');b.remove();return v==='none';}catch(e){return false;}})()",
      "specSection": "https://github.com/w3c/csswg-drafts/pull/14152"
    },
    {
      "id": "programmatic-scrolling-is-never-locked",
      "description": "Axis locking is a decision about a user gesture, so scrollBy must move both axes regardless of the property. This is the control the recorder demo rests on: if a scripted diagonal came out axis-aligned, the recorder would be measuring something else entirely.",
      "kind": "script",
      "test": "(()=>{try{const b=document.createElement('div');b.style.cssText='position:absolute;left:-10000px;width:100px;height:100px;overflow:auto';const i=document.createElement('div');i.style.cssText='width:400px;height:400px';b.append(i);document.body.append(b);b.scrollBy({left:20,top:15,behavior:'instant'});const ok=b.scrollLeft===20&&b.scrollTop===15;b.remove();return ok;}catch(e){return false;}})()",
      "specSection": "https://drafts.csswg.org/cssom-view/#dom-element-scrollby"
    }
  ]
