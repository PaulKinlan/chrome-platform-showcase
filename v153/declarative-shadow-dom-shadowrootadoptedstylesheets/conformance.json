    {
      "id": "content-attribute-reflects-to-idl",
      "description": "Setting the content attribute round-trips through the DOMString IDL reflection unchanged (space-separated specifier list).",
      "kind": "script",
      "test": "(()=>{const t=document.createElement('template');if(!('shadowRootAdoptedStyleSheets' in t))return false;t.setAttribute('shadowrootadoptedstylesheets','./a.css ./b.css');return t.shadowRootAdoptedStyleSheets==='./a.css ./b.css';})()",
      "specSection": "https://github.com/whatwg/html/pull/12339"
    },
    {
      "id": "idl-setter-reflects-to-attribute",
      "description": "Assigning the shadowRootAdoptedStyleSheets IDL attribute writes the shadowrootadoptedstylesheets content attribute ([CEReactions, Reflect]).",
      "kind": "script",
      "test": "(()=>{const t=document.createElement('template');if(!('shadowRootAdoptedStyleSheets' in t))return false;t.shadowRootAdoptedStyleSheets='./x.css';return t.getAttribute('shadowrootadoptedstylesheets')==='./x.css';})()",
      "specSection": "https://github.com/whatwg/html/pull/12339"
    },
    {
      "id": "parser-populates-adoptedstylesheets",
      "description": "Parsing a declarative shadow root whose template carries one specifier yields shadowRoot.adoptedStyleSheets of length 1 (a CSSStyleSheet is created per specifier at parse time, populated when the fetch completes).",
      "kind": "script",
      "test": "(()=>{if(!('setHTMLUnsafe' in Element.prototype))return false;const c=document.createElement('div');c.setHTMLUnsafe(\"<div><template shadowrootmode='open' shadowrootadoptedstylesheets='/v153/declarative-shadow-dom-shadowrootadoptedstylesheets/script-interop/base.css'><p>x</p></template></div>\");const h=c.firstElementChild;return !!(h&&h.shadowRoot)&&h.shadowRoot.adoptedStyleSheets.length===1;})()",
      "specSection": "https://microsoftedge.github.io/MSEdgeExplainers/ShadowDOM/explainer.html"
    },
    {
      "id": "two-specifiers-two-sheets-in-order",
      "description": "Two space-separated specifiers produce two entries in adoptedStyleSheets, in specified order.",
      "kind": "script",
      "test": "(()=>{if(!('setHTMLUnsafe' in Element.prototype))return false;const c=document.createElement('div');c.setHTMLUnsafe(\"<div><template shadowrootmode='open' shadowrootadoptedstylesheets='/v153/declarative-shadow-dom-shadowrootadoptedstylesheets/script-interop/base.css /v153/declarative-shadow-dom-shadowrootadoptedstylesheets/script-interop/accent.css'><p>x</p></template></div>\");const h=c.firstElementChild;return !!(h&&h.shadowRoot)&&h.shadowRoot.adoptedStyleSheets.length===2;})()",
      "specSection": "https://github.com/whatwg/html/pull/12339"
    },
    {
      "id": "duplicate-specifiers-collapse",
      "description": "The attribute value is parsed as an ordered set of unique tokens: a duplicated specifier yields a single adopted sheet.",
      "kind": "script",
      "test": "(()=>{if(!('setHTMLUnsafe' in Element.prototype))return false;const c=document.createElement('div');c.setHTMLUnsafe(\"<div><template shadowrootmode='open' shadowrootadoptedstylesheets='/v153/declarative-shadow-dom-shadowrootadoptedstylesheets/script-interop/base.css /v153/declarative-shadow-dom-shadowrootadoptedstylesheets/script-interop/base.css'><p>x</p></template></div>\");const h=c.firstElementChild;return !!(h&&h.shadowRoot)&&h.shadowRoot.adoptedStyleSheets.length===1;})()",
      "specSection": "https://github.com/whatwg/html/pull/12339"
