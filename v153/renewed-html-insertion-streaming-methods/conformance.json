      "description": "setHTMLUnsafe(html, {runScripts: true}) executes an inserted inline script after insertion.",
      "kind": "script",
      "test": "(()=>{const d=document.createElement('div');document.body.appendChild(d);window.__rhismConfRS=false;try{d.setHTMLUnsafe('<scr'+'ipt>window.__rhismConfRS=true</scr'+'ipt>',{runScripts:true});}catch(e){d.remove();return false;}const ok=window.__rhismConfRS===true;d.remove();delete window.__rhismConfRS;return ok;})()",
