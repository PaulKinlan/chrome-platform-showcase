    },
    {
      "id": "sethtmlunsafe-default-inert-scripts",
      "description": "setHTMLUnsafe keeps inserted scripts inert when runScripts is not requested (the mandated default).",
      "kind": "script",
      "test": "(()=>{const d=document.createElement('div');document.body.appendChild(d);window.__rhismConfInert=false;d.setHTMLUnsafe('<scr'+'ipt>window.__rhismConfInert=true</scr'+'ipt>');const ok=window.__rhismConfInert===false;d.remove();delete window.__rhismConfInert;return ok;})()",
      "specSection": "https://github.com/WICG/declarative-partial-updates/blob/main/dynamic-markup-revamped-explainer.md#script-execution",
      "expectedBrowsers": ["chrome", "edge", "firefox", "safari"]
    },
