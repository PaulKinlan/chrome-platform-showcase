      "id": "streamhtml-unsafe-returns-writablestream",
      "description": "streamHTMLUnsafe() returns a WritableStream that accepts markup chunks.",
      "kind": "script",
      "test": "(()=>{if(typeof Element.prototype.streamHTMLUnsafe!=='function')return false;const d=document.createElement('div');const ws=d.streamHTMLUnsafe({});const ok=ws instanceof WritableStream;try{ws.getWriter().close();}catch(e){}return ok;})()",
