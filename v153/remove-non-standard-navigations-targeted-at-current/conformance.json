  "author": "claude-opus-5-v153-removal-build",
  "assertions": [
    {
      "id": "target-reflects-verbatim",
      "description": "The target IDL attribute reflects its content attribute with no normalisation, so a non-standard value such as _current survives round-tripping and the case of it is preserved. This is what lets a page audit its own markup for the removed keyword.",
      "kind": "script",
      "test": "(()=>{try{const a=document.createElement('a');a.setAttribute('target','_CURRENT');if(a.target!=='_CURRENT')return false;a.target='_current';return a.getAttribute('target')==='_current'&&document.createElement('a').target==='';}catch(e){return false;}})()",
      "specSection": "https://html.spec.whatwg.org/multipage/text-level-semantics.html#dom-a-target"
    },
    {
      "id": "a-frame-name-may-begin-with-an-underscore",
      "description": "The name content attribute of an iframe is stored verbatim, so a browsing context genuinely named _current can exist. The removal matters precisely because such a frame was unreachable by name from Chrome while the keyword existed.",
      "kind": "script",
      "test": "(()=>{try{const f=document.createElement('iframe');f.setAttribute('name','_current');return f.name==='_current'&&f.getAttribute('name')==='_current';}catch(e){return false;}})()",
      "specSection": "https://html.spec.whatwg.org/multipage/iframe-embed-object.html#dom-iframe-name"
    },
    {
      "id": "every-targetable-element-carries-the-same-attribute",
      "description": "A target is a browsing-context name in all four positions the standard defines it in — a, area, form and base — which is why a removal of one keyword has to be audited across all of them rather than just in links.",
      "kind": "script",
      "test": "(()=>{try{return ['HTMLAnchorElement','HTMLAreaElement','HTMLFormElement','HTMLBaseElement'].every(n=>'target' in window[n].prototype);}catch(e){return false;}})()",
      "specSection": "https://html.spec.whatwg.org/multipage/document-sequences.html#valid-navigable-target-name-or-keyword"
    },
    {
      "id": "a-named-frame-is-reachable-by-its-name",
      "description": "Ordinary name lookup — the mechanism the removal returns _current to. A frame carrying a name appears under that name in the containing window's frame list, which is the step the extra keyword branch used to skip.",
      "kind": "script",
      "test": "(()=>{const f=document.createElement('iframe');try{f.name='cps-conformance-probe';f.setAttribute('aria-hidden','true');f.style.display='none';document.body.appendChild(f);return window.frames['cps-conformance-probe']===f.contentWindow;}catch(e){return false;}finally{f.remove();}})()",
      "specSection": "https://html.spec.whatwg.org/multipage/document-sequences.html#the-rules-for-choosing-a-navigable"
    }
  ]
}
