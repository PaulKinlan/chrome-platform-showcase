  "assertions": [
    {
      "id": "sharedworker-constructor-exposed",
      "description": "The SharedWorker constructor is exposed on Window (the only way to cause a connect event).",
      "kind": "typeof",
      "test": "SharedWorker",
      "expect": "function",
      "specSection": "https://html.spec.whatwg.org/multipage/workers.html#dom-sharedworker",
      "expectedBrowsers": [
        "firefox",
        "safari"
      ]
    },
    {
      "id": "connect-data-is-empty-string",
      "description": "The browser-fired connect event's data attribute is the empty string on the first connection (HTML run a worker).",
      "kind": "script",
      "test": "(()=>new Promise(resolve=>{let w,u;const done=v=>{clearTimeout(t);try{URL.revokeObjectURL(u)}catch(_){}resolve(v)};const t=setTimeout(()=>done(false),5000);try{u=URL.createObjectURL(new Blob([`onconnect=e=>e.ports[0].postMessage(e.data==='')`],{type:'text/javascript'}));w=new SharedWorker(u);w.onerror=()=>done(false);w.port.onmessage=m=>{const d=m.data;done(d===true)};}catch(e){done(false)}}))()",
      "specSection": "https://html.spec.whatwg.org/multipage/workers.html#run-a-worker",
      "expectedBrowsers": [
        "firefox",
        "safari"
      ]
    },
    {
      "id": "connect-data-typeof-string",
      "description": "typeof data on the connect event is \"string\", not \"object\" (i.e. not null).",
      "kind": "script",
      "test": "(()=>new Promise(resolve=>{let w,u;const done=v=>{clearTimeout(t);try{URL.revokeObjectURL(u)}catch(_){}resolve(v)};const t=setTimeout(()=>done(false),5000);try{u=URL.createObjectURL(new Blob([`onconnect=e=>e.ports[0].postMessage(typeof e.data)`],{type:'text/javascript'}));w=new SharedWorker(u);w.onerror=()=>done(false);w.port.onmessage=m=>{const d=m.data;done(d==='string')};}catch(e){done(false)}}))()",
      "specSection": "https://html.spec.whatwg.org/multipage/workers.html#run-a-worker",
      "expectedBrowsers": [
        "firefox",
        "safari"
      ]
    },
    {
      "id": "existing-worker-connect-data-empty-string",
      "description": "A second SharedWorker connecting to the already-running worker also receives a connect event whose data is the empty string (SharedWorker constructor, existing-worker branch).",
      "kind": "script",
      "test": "(()=>new Promise(resolve=>{let u;const ws=[];const done=v=>{clearTimeout(t);try{URL.revokeObjectURL(u)}catch(_){}resolve(v)};const t=setTimeout(()=>done(false),5000);try{u=URL.createObjectURL(new Blob([`let n=0;onconnect=e=>{n++;e.ports[0].postMessage({n,empty:e.data===''})}`],{type:'text/javascript'}));const a=new SharedWorker(u,{name:'conf-second'});ws.push(a);a.onerror=()=>done(false);a.port.onmessage=()=>{const b=new SharedWorker(u,{name:'conf-second'});ws.push(b);b.onerror=()=>done(false);b.port.onmessage=m=>done(m.data.n===2&&m.data.empty===true)};}catch(e){done(false)}}))()",
      "specSection": "https://html.spec.whatwg.org/multipage/workers.html#dom-sharedworker",
      "expectedBrowsers": [
        "firefox",
        "safari"
      ]
    },
    {
      "id": "connect-ports-single-frozen",
      "description": "The connect event's ports attribute is a frozen array containing exactly one MessagePort.",
      "kind": "script",
      "test": "(()=>new Promise(resolve=>{let w,u;const done=v=>{clearTimeout(t);try{URL.revokeObjectURL(u)}catch(_){}resolve(v)};const t=setTimeout(()=>done(false),5000);try{u=URL.createObjectURL(new Blob([`onconnect=e=>e.ports[0].postMessage(e.ports.length===1&&Object.isFrozen(e.ports)&&e.ports[0] instanceof MessagePort)`],{type:'text/javascript'}));w=new SharedWorker(u);w.onerror=()=>done(false);w.port.onmessage=m=>{const d=m.data;done(d===true)};}catch(e){done(false)}}))()",
      "specSection": "https://html.spec.whatwg.org/multipage/workers.html#run-a-worker",
      "expectedBrowsers": [
        "firefox",
        "safari"
      ]
    },
    {
      "id": "connect-source-is-inside-port",
      "description": "The connect event's source attribute is the same inside port as ports[0].",
      "kind": "script",
      "test": "(()=>new Promise(resolve=>{let w,u;const done=v=>{clearTimeout(t);try{URL.revokeObjectURL(u)}catch(_){}resolve(v)};const t=setTimeout(()=>done(false),5000);try{u=URL.createObjectURL(new Blob([`onconnect=e=>e.ports[0].postMessage(e.source===e.ports[0])`],{type:'text/javascript'}));w=new SharedWorker(u);w.onerror=()=>done(false);w.port.onmessage=m=>{const d=m.data;done(d===true)};}catch(e){done(false)}}))()",
      "specSection": "https://html.spec.whatwg.org/multipage/workers.html#run-a-worker",
      "expectedBrowsers": [
        "firefox",
        "safari"
      ]
    },
    {
      "id": "connect-is-trusted-messageevent",
      "description": "The connect event is a trusted, non-bubbling, non-cancelable MessageEvent of type \"connect\".",
      "kind": "script",
      "test": "(()=>new Promise(resolve=>{let w,u;const done=v=>{clearTimeout(t);try{URL.revokeObjectURL(u)}catch(_){}resolve(v)};const t=setTimeout(()=>done(false),5000);try{u=URL.createObjectURL(new Blob([`onconnect=e=>e.ports[0].postMessage(e instanceof MessageEvent&&e.type==='connect'&&e.isTrusted===true&&e.bubbles===false&&e.cancelable===false)`],{type:'text/javascript'}));w=new SharedWorker(u);w.onerror=()=>done(false);w.port.onmessage=m=>{const d=m.data;done(d===true)};}catch(e){done(false)}}))()",
      "specSection": "https://html.spec.whatwg.org/multipage/workers.html#run-a-worker",
      "expectedBrowsers": [
        "firefox",
        "safari"
      ]
    },
    {
      "id": "messageevent-constructor-default-data-null",
      "description": "Only the browser-fired event changes: new MessageEvent('connect') still defaults data to null per MessageEventInit.",
      "kind": "script",
      "test": "(()=>new MessageEvent('connect').data===null)()",
      "specSection": "https://html.spec.whatwg.org/multipage/comms.html#messageeventinit",
