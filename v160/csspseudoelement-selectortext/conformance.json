{
  "release": "v160",
  "featureSlug": "csspseudoelement-selectortext",
  "chromestatusId": 5071155760332800,
  "specUrl": "https://drafts.csswg.org/css-pseudo-4/#dom-csspseudoelement-selectortext",
  "generatedAt": "2026-11-22T12:00:00Z",
  "author": "weekly-hardening-builder",
  "assertions": [
    {
      "id": "pseudo-method-exists",
      "description": "Element.prototype.pseudo() exists (the entry point that returns CSSPseudoElement objects).",
      "kind": "typeof",
      "test": "Element.prototype.pseudo",
      "expect": "function",
      "specSection": "https://drafts.csswg.org/css-pseudo-4/#csspseudoelement"
    },
    {
      "id": "selectortext-attribute-on-prototype",
      "description": "CSSPseudoElement exposes a selectorText attribute.",
      "kind": "script",
      "test": "(()=>typeof CSSPseudoElement==='function'&&'selectorText' in CSSPseudoElement.prototype)()",
      "specSection": "https://drafts.csswg.org/css-pseudo-4/#dom-csspseudoelement-selectortext"
    },
    {
      "id": "before-selectortext",
      "description": "el.pseudo('::before').selectorText is the string \"::before\".",
      "kind": "script",
      "test": "(()=>{const p=document.body.pseudo('::before');return !!p&&p.selectorText==='::before';})()",
      "specSection": "https://drafts.csswg.org/css-pseudo-4/#dom-csspseudoelement-selectortext"
    },
    {
      "id": "legacy-colon-normalized",
      "description": "The legacy single-colon form el.pseudo(':before') serializes selectorText as \"::before\".",
      "kind": "script",
      "test": "(()=>{const p=document.body.pseudo(':before');return !!p&&p.selectorText==='::before';})()",
      "specSection": "https://drafts.csswg.org/css-pseudo-4/#dom-csspseudoelement-selectortext"
    },
    {
      "id": "vt-argument-included",
      "description": "selectorText includes the functional argument: ::view-transition-group(hero) serializes as \"::view-transition-group(hero)\".",
      "kind": "script",
      "test": "(()=>{const p=document.documentElement.pseudo('::view-transition-group(hero)');return !!p&&p.selectorText==='::view-transition-group(hero)';})()",
      "specSection": "https://drafts.csswg.org/css-pseudo-4/#dom-csspseudoelement-selectortext"
    },
    {
      "id": "type-stays-base-name",
      "description": "type keeps returning only the base name (\"::view-transition-group\") while selectorText carries the argument.",
      "kind": "script",
      "test": "(()=>{const p=document.documentElement.pseudo('::view-transition-group(hero)');return !!p&&p.type==='::view-transition-group'&&typeof p.selectorText==='string'&&p.selectorText!==p.type;})()",
      "specSection": "https://drafts.csswg.org/css-pseudo-4/#dom-csspseudoelement-selectortext"
    },
    {
      "id": "selectortext-round-trips",
      "description": "Passing selectorText back to the originating element's pseudo() returns the same CSSPseudoElement object.",
      "kind": "script",
      "test": "(()=>{const h=document.documentElement;const p=h.pseudo('::view-transition-old(card)');return !!p&&typeof p.selectorText==='string'&&h.pseudo(p.selectorText)===p;})()",
      "specSection": "https://drafts.csswg.org/css-pseudo-4/#dom-csspseudoelement-selectortext"
    },
    {
      "id": "whitespace-normalized",
      "description": "Whitespace inside the argument is dropped: ::view-transition-old( hero ) serializes as \"::view-transition-old(hero)\".",
      "kind": "script",
      "test": "(()=>{const p=document.documentElement.pseudo('::view-transition-old( hero )');return !!p&&p.selectorText==='::view-transition-old(hero)';})()",
      "specSection": "https://drafts.csswg.org/css-pseudo-4/#dom-csspseudoelement-selectortext"
    },
    {
      "id": "identifier-escaped",
      "description": "A view-transition name that needs escaping (1st-card) serializes escaped as \"::view-transition-group(\\31 st-card)\" so it can round-trip.",
      "kind": "script",
      "test": "(()=>{const h=document.documentElement;const p=h.pseudo('::view-transition-group(\\\\31 st-card)');return !!p&&p.selectorText==='::view-transition-group(\\\\31 st-card)'&&h.pseudo(p.selectorText)===p;})()",
      "specSection": "https://drafts.csswg.org/css-pseudo-4/#dom-csspseudoelement-selectortext"
    },
    {
      "id": "scroll-button-keeps-author-space",
      "description": "A user-created ::scroll-button(left) keeps the author's physical direction in selectorText (CSSWG #14528).",
      "kind": "script",
      "test": "(()=>{const d=document.createElement('div');d.style.cssText='overflow:auto;width:50px;height:20px;position:absolute;visibility:hidden';d.innerHTML='<div style=\"width:200px;height:10px\"></div>';document.body.appendChild(d);let ok=false;try{const p=d.pseudo('::scroll-button(left)');ok=!!p&&p.selectorText==='::scroll-button(left)';}finally{d.remove();}return ok;})()",
      "specSection": "https://github.com/w3c/csswg-drafts/issues/14528"
    }
  ]
}
