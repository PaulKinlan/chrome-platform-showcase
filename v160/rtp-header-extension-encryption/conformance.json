{
  "release": "v160",
  "featureSlug": "rtp-header-extension-encryption",
  "chromestatusId": 5177732519559168,
  "specUrl": "https://w3c.github.io/webrtc-extensions/#rtp-header-extension-encryption",
  "generatedAt": "2026-11-22T12:00:00Z",
  "author": "weekly-hardening-builder",
  "assertions": [
    {
      "id": "default-policy-is-negotiate",
      "description": "A new RTCPeerConnection reports rtpHeaderEncryptionPolicy \"negotiate\" from getConfiguration() (the dictionary default).",
      "kind": "script",
      "test": "(()=>{const pc=new RTCPeerConnection();try{return pc.getConfiguration().rtpHeaderEncryptionPolicy==='negotiate';}finally{pc.close();}})()",
      "specSection": "https://w3c.github.io/webrtc-extensions/#rtp-header-extension-encryption"
    },
    {
      "id": "disable-value-reflected",
      "description": "Constructing with rtpHeaderEncryptionPolicy \"disable\" succeeds and getConfiguration() returns \"disable\".",
      "kind": "script",
      "test": "(()=>{const pc=new RTCPeerConnection({rtpHeaderEncryptionPolicy:'disable'});try{return pc.getConfiguration().rtpHeaderEncryptionPolicy==='disable';}finally{pc.close();}})()",
      "specSection": "https://w3c.github.io/webrtc-extensions/#rtp-header-extension-encryption"
    },
    {
      "id": "require-value-reflected",
      "description": "Constructing with rtpHeaderEncryptionPolicy \"require\" succeeds and getConfiguration() returns \"require\".",
      "kind": "script",
      "test": "(()=>{const pc=new RTCPeerConnection({rtpHeaderEncryptionPolicy:'require'});try{return pc.getConfiguration().rtpHeaderEncryptionPolicy==='require';}finally{pc.close();}})()",
      "specSection": "https://w3c.github.io/webrtc-extensions/#rtp-header-extension-encryption"
    },
    {
      "id": "invalid-enum-value-throws",
      "description": "A value outside the RTCRtpHeaderEncryptionPolicy enum makes the RTCPeerConnection constructor throw (WebIDL enum conversion).",
      "kind": "throws",
      "test": "new RTCPeerConnection({rtpHeaderEncryptionPolicy:'bogus'})",
      "specSection": "https://w3c.github.io/webrtc-extensions/#rtp-header-extension-encryption"
    },
    {
      "id": "policy-immutable-after-construction",
      "description": "setConfiguration() with a different rtpHeaderEncryptionPolicy throws InvalidModificationError (policy can only be set at construction).",
      "kind": "script",
      "test": "(()=>{const pc=new RTCPeerConnection({rtpHeaderEncryptionPolicy:'require'});try{if(pc.getConfiguration().rtpHeaderEncryptionPolicy!=='require')return false;try{pc.setConfiguration({rtpHeaderEncryptionPolicy:'negotiate'});return false;}catch(e){return e.name==='InvalidModificationError';}}finally{pc.close();}})()",
      "specSection": "https://w3c.github.io/webrtc-extensions/#rtp-header-extension-encryption"
    },
    {
      "id": "negotiate-offers-cryptex-on-rtp-sections-only",
      "description": "With \"negotiate\", an offer with audio, video and a data channel carries a=cryptex for both RTP m= sections and none on the data-channel section.",
      "kind": "script",
      "test": "(async()=>{const pc=new RTCPeerConnection({rtpHeaderEncryptionPolicy:'negotiate'});try{pc.addTransceiver('audio');pc.addTransceiver('video');pc.createDataChannel('dc');const o=await pc.createOffer();const secs=o.sdp.split(/\\r\\n(?=m=)/);const sess=secs[0].split('\\r\\n').includes('a=cryptex');const rtp=secs.slice(1).filter(s=>!s.startsWith('m=application'));const app=secs.slice(1).filter(s=>s.startsWith('m=application'));return rtp.length===2&&rtp.every(s=>sess||s.split('\\r\\n').includes('a=cryptex'))&&app.every(s=>!s.split('\\r\\n').includes('a=cryptex'));}finally{pc.close();}})()",
      "specSection": "https://w3c.github.io/webrtc-extensions/#rtp-header-extension-encryption"
    },
    {
      "id": "disable-omits-cryptex-from-offer",
      "description": "With \"disable\", an offer with audio and video contains no a=cryptex line.",
      "kind": "script",
      "test": "(async()=>{const pc=new RTCPeerConnection({rtpHeaderEncryptionPolicy:'disable'});try{if(pc.getConfiguration().rtpHeaderEncryptionPolicy!=='disable')return false;pc.addTransceiver('audio');pc.addTransceiver('video');const o=await pc.createOffer();return /m=audio/.test(o.sdp)&&!o.sdp.split('\\r\\n').includes('a=cryptex');}finally{pc.close();}})()",
      "specSection": "https://w3c.github.io/webrtc-extensions/#rtp-header-extension-encryption"
    },
    {
      "id": "require-answers-with-cryptex",
      "description": "A \"require\" answerer to a \"negotiate\" offer includes a=cryptex in its answer.",
      "kind": "script",
      "test": "(async()=>{const a=new RTCPeerConnection({rtpHeaderEncryptionPolicy:'negotiate'}),b=new RTCPeerConnection({rtpHeaderEncryptionPolicy:'require'});try{a.addTransceiver('audio');await a.setLocalDescription();await b.setRemoteDescription(a.localDescription);await b.setLocalDescription();return b.localDescription.sdp.split('\\r\\n').includes('a=cryptex');}finally{a.close();b.close();}})()",
      "specSection": "https://w3c.github.io/webrtc-extensions/#rtp-header-extension-encryption"
    },
    {
      "id": "require-rejects-answer-without-cryptex",
      "description": "A \"require\" offerer rejects an answer without a=cryptex: setRemoteDescription() rejects with InvalidAccessError.",
      "kind": "script",
      "test": "(async()=>{const a=new RTCPeerConnection({rtpHeaderEncryptionPolicy:'require'}),b=new RTCPeerConnection({rtpHeaderEncryptionPolicy:'negotiate'});try{a.addTransceiver('audio');await a.setLocalDescription();await b.setRemoteDescription(a.localDescription);await b.setLocalDescription();const sdp=b.localDescription.sdp.split('\\r\\n').filter(l=>l&&l!=='a=cryptex').join('\\r\\n')+'\\r\\n';try{await a.setRemoteDescription({type:'answer',sdp});return false;}catch(e){return e.name==='InvalidAccessError';}}finally{a.close();b.close();}})()",
      "specSection": "https://w3c.github.io/webrtc-extensions/#rtp-header-extension-encryption"
    },
    {
      "id": "negotiate-accepts-answer-without-cryptex",
      "description": "A \"negotiate\" offerer that offered a=cryptex accepts an answer without it (falls back to clear headers) instead of rejecting.",
      "kind": "script",
      "test": "(async()=>{const a=new RTCPeerConnection({rtpHeaderEncryptionPolicy:'negotiate'}),b=new RTCPeerConnection({rtpHeaderEncryptionPolicy:'negotiate'});try{a.addTransceiver('audio');await a.setLocalDescription();if(!a.localDescription.sdp.split('\\r\\n').includes('a=cryptex'))return false;await b.setRemoteDescription(a.localDescription);await b.setLocalDescription();const sdp=b.localDescription.sdp.split('\\r\\n').filter(l=>l&&l!=='a=cryptex').join('\\r\\n')+'\\r\\n';await a.setRemoteDescription({type:'answer',sdp});return a.signalingState==='stable';}finally{a.close();b.close();}})()",
      "specSection": "https://w3c.github.io/webrtc-extensions/#rtp-header-extension-encryption"
    }
  ]
}
