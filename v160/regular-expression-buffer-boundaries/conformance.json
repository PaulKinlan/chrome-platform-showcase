{
  "release": "v160",
  "featureSlug": "regular-expression-buffer-boundaries",
  "chromestatusId": 5187917373898752,
  "specUrl": "https://tc39.es/proposal-regexp-buffer-boundaries",
  "generatedAt": "2026-11-22T12:00:00Z",
  "author": "weekly-hardening-builder",
  "assertions": [
    {
      "id": "unicode-mode-accepts-buffer-escapes",
      "description": "In Unicode mode (u flag), \\A, \\z and \\Z are valid Assertion escapes, so new RegExp('\\A\\z\\Z', 'u') compiles instead of throwing 'Invalid escape'.",
      "kind": "script",
      "test": "(()=>{try{new RegExp('\\\\A\\\\z\\\\Z','u');return true}catch(e){return false}})()",
      "specSection": "https://tc39.es/proposal-regexp-buffer-boundaries",
      "expectedBrowsers": [
        "firefox"
      ]
    },
    {
      "id": "unicodesets-mode-accepts-buffer-escapes",
      "description": "The v (unicodeSets) flag enables the escapes too: /\\Afoo\\z/v matches \"foo\".",
      "kind": "script",
      "test": "(()=>{try{return new RegExp('\\\\Afoo\\\\z','v').test('foo')}catch(e){return false}})()",
      "specSection": "https://tc39.es/proposal-regexp-buffer-boundaries"
    },
    {
      "id": "start-end-ignore-multiline",
      "description": "\\A and \\z are not affected by the m flag: /\\Afoo\\z/mu matches \"foo\" but not \"foo\\nbar\" or \"bar\\nfoo\".",
      "kind": "script",
      "test": "(()=>{try{const re=new RegExp('\\\\Afoo\\\\z','mu');return re.test('foo')&&!re.test('foo\\nbar')&&!re.test('bar\\nfoo')}catch(e){return false}})()",
      "specSection": "https://tc39.es/proposal-regexp-buffer-boundaries",
      "expectedBrowsers": [
        "firefox"
      ]
    },
    {
      "id": "mixed-anchors-readme-table",
      "description": "Buffer boundaries combine with line anchors: /\\Afoo|^bar$|baz\\z/um reproduces all nine results from the proposal README.",
      "kind": "script",
      "test": "(()=>{try{const re=new RegExp('\\\\Afoo|^bar$|baz\\\\z','um');const c=[['foo',1],['foo\\n',1],['\\nfoo',0],['bar',1],['bar\\n',1],['\\nbar',1],['baz',1],['baz\\n',0],['\\nbaz',1]];return c.every(([s,w])=>re.test(s)===!!w)}catch(e){return false}})()",
      "specSection": "https://tc39.es/proposal-regexp-buffer-boundaries"
    },
    {
      "id": "capital-z-allows-one-line-terminator",
      "description": "\\Z matches at the end or before exactly one final line terminator sequence (\\r\\n, \\n, \\r, U+2028, U+2029), but not before two.",
      "kind": "script",
      "test": "(()=>{try{const re=new RegExp('end\\\\Z','u');return re.test('end')&&re.test('end\\r\\n')&&re.test('end\\n')&&re.test('end\\r')&&re.test('end ')&&re.test('end ')&&!re.test('end\\n\\n')&&!re.test('end\\nx')}catch(e){return false}})()",
      "specSection": "https://tc39.es/proposal-regexp-buffer-boundaries",
      "expectedBrowsers": [
        "firefox"
      ]
    },
    {
      "id": "escapes-equal-modifier-desugaring",
      "description": "\\A, \\z and \\Z match at exactly the same positions as (?-m:^), (?-m:$) and (?=(?:\\r\\n|\\n|\\r|\\u2028|\\u2029)?(?-m:$)) on \"a\\r\\nb\\r\\n\" with the m flag.",
      "kind": "script",
      "test": "(()=>{try{const s='a\\r\\nb\\r\\n';const pos=(src)=>[...s.matchAll(new RegExp(src,'gmu'))].map(m=>m.index).join();return pos('\\\\A')===pos('(?-m:^)')&&pos('\\\\z')===pos('(?-m:$)')&&pos('\\\\Z')===pos('(?=(?:\\\\r\\\\n|\\\\n|\\\\r|\\\\u2028|\\\\u2029)?(?-m:$))')&&pos('\\\\Z')==='4,5,6'}catch(e){return false}})()",
      "specSection": "https://tc39.es/proposal-regexp-buffer-boundaries"
    },
    {
      "id": "sticky-start-is-input-start",
      "description": "\\A succeeds only at index 0 of the input, even for a sticky regex positioned elsewhere via lastIndex.",
      "kind": "script",
      "test": "(()=>{try{const re=new RegExp('\\\\Afoo','uy');re.lastIndex=4;const later=re.test('foo\\nfoo');re.lastIndex=0;return later===false&&re.test('foo\\nfoo')===true}catch(e){return false}})()",
      "specSection": "https://tc39.es/proposal-regexp-buffer-boundaries"
    },
    {
      "id": "annex-b-literal-without-unicode-mode",
      "description": "Outside Unicode mode the Annex B grammar still treats \\A as the identity escape for the letter A: /\\Afoo/ matches \"Afoo\" and not \"foo\".",
      "kind": "script",
      "test": "(()=>{const re=new RegExp('\\\\Afoo');return re.test('Afoo')&&!re.test('foo')})()",
      "specSection": "https://tc39.es/proposal-regexp-buffer-boundaries"
    },
    {
      "id": "not-allowed-in-character-class",
      "description": "\\A is not a ClassEscape: new RegExp('[\\A]', 'u') throws a SyntaxError.",
      "kind": "throws",
      "test": "new RegExp('[\\\\A]','u')",
      "specSection": "https://tc39.es/proposal-regexp-buffer-boundaries"
    },
    {
      "id": "assertion-not-quantifiable",
      "description": "Buffer boundaries are Assertions, which cannot take a Quantifier in Unicode mode: new RegExp('\\z+', 'u') throws a SyntaxError.",
      "kind": "throws",
      "test": "new RegExp('\\\\z+','u')",
      "specSection": "https://tc39.es/proposal-regexp-buffer-boundaries"
    }
  ]
}
