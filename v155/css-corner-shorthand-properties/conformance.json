  "featureSlug": "css-corner-shorthand-properties",
  "chromestatusId": 5152215540039680,
  "specUrl": "https://drafts.csswg.org/css-borders-4/#corner-shaping",
  "generatedAt": "2026-08-28T01:20:00Z",
  "author": "claude-opus-5-v155-build",
  "assertions": [
    {
      "id": "corner-shorthand-parses",
      "description": "The corner shorthand accepts a shape and a radius together.",
      "kind": "script",
      "test": "CSS.supports('corner', 'squircle 24px')",
      "specSection": "https://drafts.csswg.org/css-borders-4/#corner-shaping"
    },
    {
      "id": "per-corner-shorthands-parse",
      "description": "All four per-corner shorthands are accepted.",
      "kind": "script",
      "test": "['corner-top-left','corner-top-right','corner-bottom-right','corner-bottom-left'].every((p)=>CSS.supports(p,'bevel 12px'))",
      "specSection": "https://drafts.csswg.org/css-borders-4/#corner-shaping"
    },
    {
      "id": "physical-edge-shorthands-parse",
      "description": "The physical edge shorthands corner-top and corner-bottom are accepted.",
      "kind": "script",
      "test": "CSS.supports('corner-top','bevel 12px') && CSS.supports('corner-bottom','bevel 12px')",
      "specSection": "https://drafts.csswg.org/css-borders-4/#corner-shaping"
    },
    {
      "id": "logical-edge-shorthands-parse",
      "description": "The logical edge shorthands are accepted, so a component can be styled once for every writing mode.",
      "kind": "script",
      "test": "CSS.supports('corner-block-start','notch 10px') && CSS.supports('corner-block-end','notch 10px')",
      "specSection": "https://drafts.csswg.org/css-borders-4/#corner-shaping"
    },
    {
      "id": "corners-alias-parses",
      "description": "`corners` is retained as a compatibility alias for `corner`.",
      "kind": "script",
      "test": "CSS.supports('corners', 'round 8px')",
      "specSection": "https://drafts.csswg.org/css-borders-4/#corner-shaping"
    },
    {
      "id": "corner-shorthand-sets-both-longhands",
      "description": "The shorthand must set border-radius AND corner-shape for the corner it names, not just one of them. Reading both longhands back is the only way to tell a real shorthand from a parse that quietly dropped half the value.",
      "kind": "script",
      "test": "(()=>{if(!CSS.supports('corner-top-left','bevel 18px'))return false;const el=document.createElement('div');el.style.cssText='position:absolute;visibility:hidden;width:50px;height:50px';el.style.setProperty('corner-top-left','bevel 18px');document.body.append(el);const cs=getComputedStyle(el);const radius=cs.borderTopLeftRadius;const shape=cs.getPropertyValue('corner-top-left-shape').trim();el.remove();return radius==='18px'&&shape==='bevel';})()",
      "specSection": "https://drafts.csswg.org/css-borders-4/#corner-shaping"
    },
    {
      "id": "corner-shorthand-leaves-other-corners-alone",
      "description": "A per-corner shorthand must affect only its own corner. If it reset the other three it would be a shorthand for the whole box wearing a per-corner name.",
      "kind": "script",
      "test": "(()=>{if(!CSS.supports('corner-top-left','bevel 18px'))return false;const el=document.createElement('div');el.style.cssText='position:absolute;visibility:hidden;width:50px;height:50px;border-radius:6px';el.style.setProperty('corner-top-left','bevel 18px');document.body.append(el);const cs=getComputedStyle(el);const others=[cs.borderTopRightRadius,cs.borderBottomRightRadius,cs.borderBottomLeftRadius];el.remove();return others.every((v)=>v==='6px');})()",
      "specSection": "https://drafts.csswg.org/css-borders-4/#corner-shaping"
    },
    {
      "id": "logical-corner-radius-follows-writing-mode",
      "description": "border-start-start-radius must map to a different physical corner when the writing mode changes. This is the behaviour the logical corner shorthands inherit, and it is what makes them worth having.",
      "kind": "script",
      "test": "(()=>{if(!CSS.supports('border-start-start-radius','30px'))return false;const make=(mode)=>{const el=document.createElement('div');el.style.cssText='position:absolute;visibility:hidden;width:50px;height:50px;writing-mode:'+mode;el.style.setProperty('border-start-start-radius','30px');document.body.append(el);const cs=getComputedStyle(el);const out=[cs.borderTopLeftRadius,cs.borderTopRightRadius,cs.borderBottomRightRadius,cs.borderBottomLeftRadius].join(',');el.remove();return out;};return make('horizontal-tb')!==make('vertical-rl');})()",
      "specSection": "https://drafts.csswg.org/css-logical-1/#corner-radius-properties"
    }
  ]
}
