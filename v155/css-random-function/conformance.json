    {
      "id": "random-parses-as-a-length",
      "description": "random() is accepted where a length is expected.",
      "kind": "script",
      "test": "CSS.supports('height', 'random(20px, 100px)')",
      "specSection": "https://www.w3.org/TR/css-values-5/#random"
    },
    {
      "id": "random-parses-as-a-percentage",
      "description": "random() is accepted where a percentage is expected, which is the scattering case.",
      "kind": "script",
      "test": "CSS.supports('top', 'random(0%, 100%)')",
      "specSection": "https://www.w3.org/TR/css-values-5/#random"
    },
    {
      "id": "random-accepts-a-step",
      "description": "The optional `by <step>` argument snaps results to a grid.",
      "kind": "script",
      "test": "CSS.supports('top', 'random(0%, 100%, by 5%)')",
      "specSection": "https://www.w3.org/TR/css-values-5/#random"
    },
    {
      "id": "random-accepts-a-dashed-ident-cache-key",
      "description": "A dashed-ident names a cache slot so two functions can resolve to the same value within an element.",
      "kind": "script",
      "test": "CSS.supports('width', 'random(--paired, 20px, 100px)')",
      "specSection": "https://drafts.csswg.org/css-values-5/#random-caching"
    },
    {
      "id": "random-accepts-per-element-caching",
      "description": "per-element keys the cache to the element rather than to an author-chosen name.",
      "kind": "script",
      "test": "CSS.supports('width', 'random(per-element, 20px, 100px)')",
      "specSection": "https://drafts.csswg.org/css-values-5/#random-caching"
    },
    {
      "id": "random-accepts-fixed-caching",
      "description": "fixed resolves once per document, so every element receives the same value.",
      "kind": "script",
      "test": "CSS.supports('width', 'random(fixed, 20px, 100px)')",
      "specSection": "https://drafts.csswg.org/css-values-5/#random-caching"
    },
    {
      "id": "random-resolves-differently-per-element-by-default",
      "description": "With no caching argument each element resolves its own value. Rendering twelve elements from one rule must produce more than one distinct computed height, or the function is not doing what scattering needs.",
      "kind": "script",
      "test": "(()=>{if(!CSS.supports('height','random(20px, 100px)'))return false;const host=document.createElement('div');host.style.position='absolute';host.style.visibility='hidden';const id='rnd'+Math.floor(performance.now());host.id=id;const style=document.createElement('style');style.textContent='#'+id+' i{display:block;height:random(20px, 100px)}';for(let n=0;n<12;n++)host.appendChild(document.createElement('i'));document.body.append(style,host);const heights=new Set([...host.children].map(el=>getComputedStyle(el).height));host.remove();style.remove();return heights.size>1;})()",
      "specSection": "https://www.w3.org/TR/css-values-5/#random"
    },
    {
      "id": "random-with-fixed-resolves-identically-across-elements",
      "description": "fixed must collapse to a single value for the whole document: twelve elements sharing one fixed random() must all compute the same height. This is the assertion that distinguishes fixed from per-element rather than merely parsing it.",
      "kind": "script",
      "test": "(()=>{if(!CSS.supports('height','random(fixed, 20px, 100px)'))return false;const host=document.createElement('div');host.style.position='absolute';host.style.visibility='hidden';const id='rndf'+Math.floor(performance.now());host.id=id;const style=document.createElement('style');style.textContent='#'+id+' i{display:block;height:random(fixed, 20px, 100px)}';for(let n=0;n<12;n++)host.appendChild(document.createElement('i'));document.body.append(style,host);const heights=new Set([...host.children].map(el=>getComputedStyle(el).height));host.remove();style.remove();return heights.size===1;})()",
      "specSection": "https://drafts.csswg.org/css-values-5/#random-caching"
    }
  ]
