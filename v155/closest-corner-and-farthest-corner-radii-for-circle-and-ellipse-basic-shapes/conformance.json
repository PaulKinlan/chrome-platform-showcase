    },
    {
      "id": "corner-keywords-work-in-offset-path",
      "description": "The keywords work in offset-path, completing the set of properties that take a basic shape.",
      "kind": "script",
      "test": "CSS.supports('offset-path', 'circle(farthest-corner at 50% 50%)')",
