      "test": "CSS.supports('clip-path', 'circle(farthest-corner at 30% 40%)')",
      "specSection": "https://drafts.csswg.org/css-shapes-1/#funcdef-basic-shape-circle"
    },
    {
      "id": "ellipse-accepts-corner-keywords",
      "description": "ellipse() takes two radii, and both accept the corner keywords.",
      "kind": "script",
      "test": "CSS.supports('clip-path', 'ellipse(closest-corner farthest-corner at 40% 40%)')",
      "specSection": "https://drafts.csswg.org/css-shapes-1/#funcdef-basic-shape-ellipse"
    },
    {
