      "id": "context-display-p3-linear-round-trips",
      "description": "getContext('2d', { colorSpace: 'display-p3-linear' }) creates a context whose getContextAttributes().colorSpace reads back 'display-p3-linear'.",
      "kind": "script",
      "test": "(()=>{try{const c=document.createElement('canvas').getContext('2d',{colorSpace:'display-p3-linear'});return c.getContextAttributes().colorSpace==='display-p3-linear';}catch{return false;}})()",
      "specSection": "https://html.spec.whatwg.org/multipage/canvas.html#dom-predefinedcolorspace-display-p3-linear"
    },
    {
      "id": "imagedata-srgb-linear-constructs",
      "description": "new ImageData(1, 1, { colorSpace: 'srgb-linear' }) constructs and its colorSpace property reads back 'srgb-linear'.",
      "kind": "script",
      "test": "(()=>{try{return new ImageData(1,1,{colorSpace:'srgb-linear'}).colorSpace==='srgb-linear';}catch{return false;}})()",
      "specSection": "https://html.spec.whatwg.org/multipage/canvas.html#pixel-manipulation"
    },
    {
      "id": "imagedata-display-p3-linear-constructs",
      "description": "new ImageData(1, 1, { colorSpace: 'display-p3-linear' }) constructs and its colorSpace property reads back 'display-p3-linear'.",
      "kind": "script",
      "test": "(()=>{try{return new ImageData(1,1,{colorSpace:'display-p3-linear'}).colorSpace==='display-p3-linear';}catch{return false;}})()",
      "specSection": "https://html.spec.whatwg.org/multipage/canvas.html#pixel-manipulation"
    },
    {
      "id": "getimagedata-converts-into-srgb-linear",
      "description": "getImageData(..., { colorSpace: 'srgb-linear' }) on an srgb canvas returns an ImageData tagged srgb-linear whose mid-grey bytes are lower than the gamma-encoded source bytes (linear-light conversion actually happened).",
      "kind": "script",
      "test": "(()=>{try{const c=document.createElement('canvas');c.width=1;c.height=1;const x=c.getContext('2d');x.fillStyle='rgb(128 128 128)';x.fillRect(0,0,1,1);const d=x.getImageData(0,0,1,1,{colorSpace:'srgb-linear'});return d.colorSpace==='srgb-linear'&&d.data[0]<100&&d.data[0]>30;}catch{return false;}})()",
      "specSection": "https://html.spec.whatwg.org/multipage/canvas.html#colour-spaces-and-colour-correction"
    },
    {
      "id": "unknown-enum-value-throws",
      "description": "Per WebIDL enum semantics, an unknown PredefinedColorSpace value passed to getContext must throw a TypeError, not be silently ignored.",
      "kind": "throws",
      "test": "document.createElement('canvas').getContext('2d',{colorSpace:'definitely-not-a-color-space'})",
      "specSection": "https://webidl.spec.whatwg.org/#idl-enums"
    },
    {
      "id": "pre-existing-display-p3-still-round-trips",
      "description": "The pre-existing enum values remain intact: getContext('2d', { colorSpace: 'display-p3' }) still reads back 'display-p3' alongside the new linear values.",
      "kind": "script",
      "test": "(()=>{try{const c=document.createElement('canvas').getContext('2d',{colorSpace:'display-p3'});return c.getContextAttributes().colorSpace==='display-p3';}catch{return false;}})()",
      "specSection": "https://html.spec.whatwg.org/multipage/canvas.html#dom-predefinedcolorspace-display-p3"
    },
    {
      "id": "linear-gradient-midpoint-preserves-light",
      "description": "On an srgb-linear canvas, a red-to-green gradient's midpoint read back as srgb bytes is brighter than the gamma-interpolated midpoint (interpolation really runs in linear light).",
      "kind": "script",
      "test": "(()=>{try{const mk=(space)=>{const c=document.createElement('canvas');c.width=64;c.height=1;const x=space?c.getContext('2d',{colorSpace:space}):c.getContext('2d');const g=x.createLinearGradient(0,0,64,0);g.addColorStop(0,'#ff0000');g.addColorStop(1,'#00ff00');x.fillStyle=g;x.fillRect(0,0,64,1);return x.getImageData(32,0,1,1,{colorSpace:'srgb'}).data;};const lin=mk('srgb-linear');const gam=mk(null);return lin[0]>gam[0]+10&&lin[1]>gam[1]+10;}catch{return false;}})()",
      "specSection": "https://html.spec.whatwg.org/multipage/canvas.html#colour-spaces-and-colour-correction"
    }
  ]
