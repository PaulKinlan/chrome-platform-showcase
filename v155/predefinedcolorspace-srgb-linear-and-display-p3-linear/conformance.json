    {
      "id": "context-srgb-linear-round-trips",
      "description": "getContext('2d', { colorSpace: 'srgb-linear' }) creates a context whose getContextAttributes().colorSpace reads back 'srgb-linear'.",
      "kind": "script",
      "test": "(()=>{try{const c=document.createElement('canvas').getContext('2d',{colorSpace:'srgb-linear'});return c.getContextAttributes().colorSpace==='srgb-linear';}catch{return false;}})()",
      "specSection": "https://html.spec.whatwg.org/multipage/canvas.html#dom-predefinedcolorspace-srgb-linear"
    },
