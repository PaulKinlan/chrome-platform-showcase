{
  "release": "v161",
  "featureSlug": "css-color-mix-with-one-or-more-colors",
  "chromestatusId": 5009529854099456,
  "specUrl": "https://drafts.csswg.org/css-color-5/#color-mix",
  "generatedAt": "2026-11-26T07:00:00Z",
  "author": "daily-build-routine",
  "assertions": [
    {
      "id": "three-colours-parse",
      "description": "color-mix() accepts three colours with no percentages.",
      "kind": "css-supports",
      "test": "color: color-mix(in srgb, red, lime, blue)",
      "specSection": "https://drafts.csswg.org/css-color-5/#color-mix",
      "expectedBrowsers": [
        "firefox",
        "safari"
      ]
    },
    {
      "id": "single-colour-parse",
      "description": "color-mix() accepts a single colour.",
      "kind": "css-supports",
      "test": "color: color-mix(in hsl, teal)",
      "specSection": "https://drafts.csswg.org/css-color-5/#color-mix",
      "expectedBrowsers": [
        "firefox",
        "safari"
      ]
    },
    {
      "id": "interpolation-method-optional",
      "description": "The colour interpolation method is optional and defaults to oklab.",
      "kind": "script",
      "test": "(()=>{const d=document.createElement('div');document.body.append(d);d.style.color='color-mix(red, blue)';const a=getComputedStyle(d).color;d.style.color='color-mix(in oklab, red, blue)';const b=getComputedStyle(d).color;d.remove();return a===b&&a.startsWith('oklab(');})()",
      "specSection": "https://drafts.csswg.org/css-color-5/#color-mix-space",
      "expectedBrowsers": [
        "firefox",
        "safari"
      ]
    },
    {
      "id": "equal-three-way-mix",
      "description": "color-mix(in srgb, red, lime, blue) is an equal one-third mix of each colour.",
      "kind": "script",
      "test": "(()=>{const d=document.createElement('div');document.body.append(d);d.style.color='color-mix(in srgb, red, lime, blue)';const c=d.style.color?getComputedStyle(d).color:'';d.remove();const g=(c.match(/-?[\\d.]+/g)||[]).map(Number);const e=[0.333333, 0.333333, 0.333333];return g.length===e.length&&g.every((v,i)=>Math.abs(v-e[i])<0.001);})()",
      "specSection": "https://drafts.csswg.org/css-color-5/#color-mix-result",
      "expectedBrowsers": [
        "firefox",
        "safari"
      ]
    },
    {
      "id": "sum-under-100-becomes-alpha",
      "description": "Percentages that sum to 90% produce alpha 0.9.",
      "kind": "script",
      "test": "(()=>{const d=document.createElement('div');document.body.append(d);d.style.color='color-mix(in srgb, red 30%, lime 30%, blue 30%)';const c=d.style.color?getComputedStyle(d).color:'';d.remove();const g=(c.match(/-?[\\d.]+/g)||[]).map(Number);const e=[0.333333, 0.333333, 0.333333, 0.9];return g.length===e.length&&g.every((v,i)=>Math.abs(v-e[i])<0.001);})()",
      "specSection": "https://drafts.csswg.org/css-values-5/#normalize-mix-percentages",
      "expectedBrowsers": [
        "firefox",
        "safari"
      ]
    },
    {
      "id": "sum-over-100-scales",
      "description": "Percentages that sum to more than 100% are scaled down proportionally.",
      "kind": "script",
      "test": "(()=>{const d=document.createElement('div');document.body.append(d);d.style.color='color-mix(in srgb, red 50%, lime 50%, blue 50%)';const c=d.style.color?getComputedStyle(d).color:'';d.remove();const g=(c.match(/-?[\\d.]+/g)||[]).map(Number);const e=[0.333333, 0.333333, 0.333333];return g.length===e.length&&g.every((v,i)=>Math.abs(v-e[i])<0.001);})()",
      "specSection": "https://drafts.csswg.org/css-values-5/#normalize-mix-percentages",
      "expectedBrowsers": [
        "firefox",
        "safari"
      ]
    },
    {
      "id": "omitted-gets-remaining-only",
      "description": "An omitted percentage gets 100% minus the clamped specified sum, so it can be 0%.",
      "kind": "script",
      "test": "(()=>{const d=document.createElement('div');document.body.append(d);d.style.color='color-mix(in srgb, red 60%, lime 60%, blue)';const c=d.style.color?getComputedStyle(d).color:'';d.remove();const g=(c.match(/-?[\\d.]+/g)||[]).map(Number);const e=[0.5, 0.5, 0];return g.length===e.length&&g.every((v,i)=>Math.abs(v-e[i])<0.001);})()",
      "specSection": "https://drafts.csswg.org/css-values-5/#normalize-mix-percentages",
      "expectedBrowsers": [
        "firefox",
        "safari"
      ]
    },
    {
      "id": "all-zero-folds-at-half",
      "description": "When every percentage is 0%, each pairwise step uses progress 0.5 and the result is fully transparent.",
      "kind": "script",
      "test": "(()=>{const d=document.createElement('div');document.body.append(d);d.style.color='color-mix(in srgb, red 0%, blue 0%, lime 0%)';const c=d.style.color?getComputedStyle(d).color:'';d.remove();const g=(c.match(/-?[\\d.]+/g)||[]).map(Number);const e=[0.25, 0.5, 0.25, 0];return g.length===e.length&&g.every((v,i)=>Math.abs(v-e[i])<0.001);})()",
      "specSection": "https://drafts.csswg.org/css-color-5/#color-mix-result",
      "expectedBrowsers": [
        "firefox",
        "safari"
      ]
    },
    {
      "id": "polar-order-dependent",
      "description": "In oklch, mixing is done left to right, so reordering three colours can change the hue.",
      "kind": "script",
      "test": "(()=>{const d=document.createElement('div');document.body.append(d);d.style.color='color-mix(in oklch, red, lime, blue)';const a=d.style.color?getComputedStyle(d).color:'';d.style.color='';d.style.color='color-mix(in oklch, blue, red, lime)';const b=d.style.color?getComputedStyle(d).color:'';d.remove();return a!==''&&b!==''&&a!==b;})()",
      "specSection": "https://drafts.csswg.org/css-color-5/#color-mix-result",
      "expectedBrowsers": [
        "firefox",
        "safari"
      ]
    },
    {
      "id": "single-colour-converts",
      "description": "A single colour is converted to the interpolation colour space.",
      "kind": "script",
      "test": "(()=>{const d=document.createElement('div');document.body.append(d);d.style.color='color-mix(in oklch, teal)';const a=d.style.color?getComputedStyle(d).color:'';d.style.color='oklch(from teal l c h)';const b=getComputedStyle(d).color;d.remove();return a!==''&&a===b;})()",
      "specSection": "https://drafts.csswg.org/css-color-5/#color-mix-result",
      "expectedBrowsers": [
        "firefox",
        "safari"
      ]
    },
    {
      "id": "single-colour-percentage-fades",
      "description": "A single colour with a percentage under 100% becomes partially transparent.",
      "kind": "script",
      "test": "(()=>{const d=document.createElement('div');document.body.append(d);d.style.color='color-mix(in srgb, red 40%)';const c=d.style.color?getComputedStyle(d).color:'';d.remove();const g=(c.match(/-?[\\d.]+/g)||[]).map(Number);const e=[1, 0, 0, 0.4];return g.length===e.length&&g.every((v,i)=>Math.abs(v-e[i])<0.001);})()",
      "specSection": "https://drafts.csswg.org/css-color-5/#color-mix-result",
      "expectedBrowsers": [
        "firefox",
        "safari"
      ]
    },
    {
      "id": "percentage-out-of-range-invalid",
      "description": "Percentages outside 0% to 100% are invalid.",
      "kind": "script",
      "test": "(()=>!CSS.supports('color','color-mix(in srgb, red 120%, lime, blue)')&&!CSS.supports('color','color-mix(in srgb, red -10%, lime, blue)'))()",
      "specSection": "https://drafts.csswg.org/css-color-5/#color-mix",
      "expectedBrowsers": [
        "firefox",
        "safari"
      ]
    },
    {
      "id": "canvas-fillstyle-variadic",
      "description": "Canvas 2D fillStyle parses a three-colour color-mix() and serialises the computed colour.",
      "kind": "script",
      "test": "(()=>{const c=document.createElement('canvas').getContext('2d');c.fillStyle='#000001';c.fillStyle='color-mix(in srgb, red, lime, blue)';return c.fillStyle==='color(srgb 0.333333 0.333333 0.333333)';})()",
      "specSection": "https://drafts.csswg.org/css-color-5/#color-mix",
      "expectedBrowsers": [
        "firefox",
        "safari"
      ]
    }
  ]
