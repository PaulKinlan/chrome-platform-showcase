  "author": "daily-build-routine",
  "assertions": [
    {
      "id": "supports-literal-items",
      "description": "CSS.supports() accepts random-item() with a key and literal items.",
      "kind": "css-supports",
      "test": "color: random-item(--x, red, blue)",
      "specSection": "https://drafts.csswg.org/css-values-5/#funcdef-random-item",
      "expectedBrowsers": [
        "safari"
      ]
    },
    {
      "id": "parse-braced-items",
      "description": "An item that contains commas can be wrapped in braces: random-item(auto, {Times, serif}, {Arial, sans-serif}) is a valid font-family value.",
      "kind": "script",
      "test": "(()=>{const d=document.createElement('div');d.style.setProperty('font-family','random-item(auto, {Times, serif}, {Arial, sans-serif})');return (d.style.getPropertyValue('font-family')!=='')===true;})()",
      "specSection": "https://drafts.csswg.org/css-values-5/#funcdef-random-item",
      "expectedBrowsers": [
        "safari"
      ]
    },
    {
      "id": "parse-empty-item",
      "description": "Items may be empty: random-item(auto, , serif) parses.",
      "kind": "script",
      "test": "(()=>{const d=document.createElement('div');d.style.setProperty('font-family','random-item(auto, , serif)');return (d.style.getPropertyValue('font-family')!=='')===true;})()",
      "specSection": "https://drafts.csswg.org/css-values-5/#funcdef-random-item",
      "expectedBrowsers": [
        "safari"
      ]
    },
    {
      "id": "parse-key-required",
      "description": "random-item(auto) with no items is invalid at parse time (the key is required and at least one item must follow).",
      "kind": "script",
      "test": "(()=>{const d=document.createElement('div');d.style.setProperty('font-family','random-item(auto, serif)');const okValid=d.style.getPropertyValue('font-family')!=='';d.style.removeProperty('font-family');d.style.setProperty('font-family','random-item(auto)');return okValid&&d.style.getPropertyValue('font-family')==='';})()",
      "specSection": "https://drafts.csswg.org/css-values-5/#funcdef-random-item",
      "expectedBrowsers": [
        "safari"
      ]
    },
    {
      "id": "parse-unbalanced-brace",
      "description": "An unbalanced brace in an item makes the declaration invalid, while the balanced form is valid.",
      "kind": "script",
      "test": "(()=>{const d=document.createElement('div');d.style.setProperty('font-family','random-item(auto, {serif})');const okValid=d.style.getPropertyValue('font-family')!=='';d.style.removeProperty('font-family');d.style.setProperty('font-family','random-item(auto, {serif)');return okValid&&d.style.getPropertyValue('font-family')==='';})()",
      "specSection": "https://drafts.csswg.org/css-values-5/#funcdef-random-item",
      "expectedBrowsers": [
        "safari"
      ]
    },
    {
      "id": "fixed-zero-picks-first",
      "description": "fixed 0 picks the first item: random-item(fixed 0, rgb(1, 0, 0), rgb(0, 1, 0), rgb(0, 0, 1)) computes to rgb(1, 0, 0).",
      "kind": "script",
      "test": "(()=>{const h=document.createElement('div');h.style.color='rgb(0, 0, 0)';const d=document.createElement('div');h.append(d);document.body.append(h);d.style.setProperty('color','random-item(fixed 0, rgb(1, 0, 0), rgb(0, 1, 0), rgb(0, 0, 1))');const ok=d.style.getPropertyValue('color')!==''&&getComputedStyle(d).getPropertyValue('color').trim()==='rgb(1, 0, 0)';h.remove();return ok;})()",
      "specSection": "https://drafts.csswg.org/css-values-5/#random-evaluation",
      "expectedBrowsers": [
        "safari"
      ]
    },
    {
      "id": "fixed-half-picks-middle",
      "description": "Index is round(down, R * N, 1): fixed 0.5 with three items picks the second, rgb(0, 1, 0).",
      "kind": "script",
      "test": "(()=>{const h=document.createElement('div');h.style.color='rgb(0, 0, 0)';const d=document.createElement('div');h.append(d);document.body.append(h);d.style.setProperty('color','random-item(fixed 0.5, rgb(1, 0, 0), rgb(0, 1, 0), rgb(0, 0, 1))');const ok=d.style.getPropertyValue('color')!==''&&getComputedStyle(d).getPropertyValue('color').trim()==='rgb(0, 1, 0)';h.remove();return ok;})()",
      "specSection": "https://drafts.csswg.org/css-values-5/#random-evaluation",
      "expectedBrowsers": [
        "safari"
      ]
    },
    {
      "id": "fixed-one-clamped",
      "description": "fixed 1 is clamped below 1, so it picks the last item, rgb(0, 0, 1).",
      "kind": "script",
      "test": "(()=>{const h=document.createElement('div');h.style.color='rgb(0, 0, 0)';const d=document.createElement('div');h.append(d);document.body.append(h);d.style.setProperty('color','random-item(fixed 1, rgb(1, 0, 0), rgb(0, 1, 0), rgb(0, 0, 1))');const ok=d.style.getPropertyValue('color')!==''&&getComputedStyle(d).getPropertyValue('color').trim()==='rgb(0, 0, 1)';h.remove();return ok;})()",
      "specSection": "https://drafts.csswg.org/css-values-5/#valdef-random-fixed",
      "expectedBrowsers": [
        "safari"
      ]
    },
    {
      "id": "braced-item-substituted-without-braces",
      "description": "A braced item is substituted without its braces: random-item(fixed 0.999, {Times, serif}, {Arial, sans-serif}) computes to Arial, sans-serif.",
      "kind": "script",
      "test": "(()=>{const h=document.createElement('div');h.style.color='rgb(0, 0, 0)';const d=document.createElement('div');h.append(d);document.body.append(h);d.style.setProperty('font-family','random-item(fixed 0.999, {Times, serif}, {Arial, sans-serif})');const ok=d.style.getPropertyValue('font-family')!==''&&getComputedStyle(d).getPropertyValue('font-family').trim()==='Arial, sans-serif';h.remove();return ok;})()",
      "specSection": "https://drafts.csswg.org/css-values-5/#funcdef-random-item",
      "expectedBrowsers": [
        "safari"
      ]
    },
    {
      "id": "empty-item-iacvt",
      "description": "Picking an empty item makes the property invalid at computed-value time: color inherits rgb(0, 0, 0) instead of the earlier green.",
      "kind": "script",
      "test": "(()=>{const h=document.createElement('div');h.style.color='rgb(0, 0, 0)';const d=document.createElement('div');h.append(d);document.body.append(h);d.style.color='green';d.style.color='random-item(fixed 0.5, red, , blue)';const ok=d.style.color!==''&&d.style.color!=='green'&&getComputedStyle(d).color==='rgb(0, 0, 0)';h.remove();return ok;})()",
      "specSection": "https://drafts.csswg.org/css-values-5/#funcdef-random-item",
      "expectedBrowsers": [
        "safari"
      ]
    },
    {
      "id": "unpicked-var-not-resolved",
      "description": "Only the chosen item is substituted: random-item(fixed 0.999, var(--missing), rgb(1, 2, 3)) computes to rgb(1, 2, 3).",
      "kind": "script",
      "test": "(()=>{const h=document.createElement('div');h.style.color='rgb(0, 0, 0)';const d=document.createElement('div');h.append(d);document.body.append(h);d.style.setProperty('color','random-item(fixed 0.999, var(--missing), rgb(1, 2, 3))');const ok=d.style.getPropertyValue('color')!==''&&getComputedStyle(d).getPropertyValue('color').trim()==='rgb(1, 2, 3)';h.remove();return ok;})()",
      "specSection": "https://drafts.csswg.org/css-values-5/#funcdef-random-item",
      "expectedBrowsers": [
        "safari"
      ]
    },
    {
      "id": "nested-random-item",
      "description": "random-item() nested in a chosen item resolves: random-item(fixed 0, random-item(fixed 0.999, red, rgb(1, 2, 3)), blue) computes to rgb(1, 2, 3).",
      "kind": "script",
      "test": "(()=>{const h=document.createElement('div');h.style.color='rgb(0, 0, 0)';const d=document.createElement('div');h.append(d);document.body.append(h);d.style.setProperty('color','random-item(fixed 0, random-item(fixed 0.999, red, rgb(1, 2, 3)), blue)');const ok=d.style.getPropertyValue('color')!==''&&getComputedStyle(d).getPropertyValue('color').trim()==='rgb(1, 2, 3)';h.remove();return ok;})()",
      "specSection": "https://drafts.csswg.org/css-values-5/#funcdef-random-item",
      "expectedBrowsers": [
        "safari"
      ]
    },
    {
      "id": "shorthand-expansion",
      "description": "A chosen item can be a full shorthand value: margin: random-item(fixed 0, 1px 2px, 3px 4px) gives margin-top 1px and margin-right 2px.",
      "kind": "script",
      "test": "(()=>{const d=document.createElement('div');document.body.append(d);d.style.margin='random-item(fixed 0, 1px 2px, 3px 4px)';const cs=getComputedStyle(d);const ok=d.style.margin!==''&&cs.marginTop==='1px'&&cs.marginRight==='2px';d.remove();return ok;})()",
      "specSection": "https://drafts.csswg.org/css-values-5/#funcdef-random-item",
      "expectedBrowsers": [
        "safari"
      ]
    },
    {
      "id": "shared-dashed-key",
      "description": "Two elements using the same <dashed-ident> key pick the same item (the key, not the element, names the random value).",
      "kind": "script",
      "test": "(()=>{const items=Array.from({length:50},(_,i)=>i+'px').join(', ');const a=document.createElement('div'),b=document.createElement('div');document.body.append(a,b);for(const e of [a,b])e.style.width='random-item(--conf-shared, '+items+')';const ok=a.style.width!==''&&getComputedStyle(a).width===getComputedStyle(b).width;a.remove();b.remove();return ok;})()",
      "specSection": "https://drafts.csswg.org/css-values-5/#random-caching",
      "expectedBrowsers": [
        "safari"
      ]
    },
    {
      "id": "invalid-key-iacvt",
      "description": "The key is parsed at computed-value time: random-item(fixed -0.5, red, blue) parses but makes color invalid at computed-value time.",
      "kind": "script",
      "test": "(()=>{const h=document.createElement('div');h.style.color='rgb(0, 0, 0)';const d=document.createElement('div');h.append(d);document.body.append(h);d.style.color='random-item(fixed -0.5, rgb(1, 0, 0), rgb(0, 0, 1))';const ok=d.style.color!==''&&getComputedStyle(d).color==='rgb(0, 0, 0)';h.remove();return ok;})()",
      "specSection": "https://drafts.csswg.org/css-values-5/#random-caching",
      "expectedBrowsers": [
        "safari"
      ]
    }
  ]
}
