    "test-spc-bbk-device-name": "node --test scripts/spc-bbk-device-name.test.mjs",
    "test-spc-bbk-jwk-shape": "node --expose-gc --test scripts/spc-bbk-jwk-shape.test.mjs",
    "test-dbsc-jwk-shape": "node --expose-gc --test scripts/dbsc-jwk-shape.test.mjs",
    "test-evp-nonce-replay": "node --expose-gc --test scripts/evp-nonce-replay.test.mjs",
    "test-speculation-probe-store": "node --test scripts/speculation-probe-store.test.mjs",
    "test-speculation-probe-docs": "node --expose-gc --test scripts/speculation-probe-docs.test.mjs",
    "test-drive-effect": "node --test scripts/drive-effect.test.mjs",
