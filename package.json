    "fmt-check": "dprint check",
    "test-speech-transcript-dom": "node --test scripts/speech-transcript-dom.test.mjs",
    "test-speech-transcript-highlight": "node --test scripts/speech-transcript-highlight.test.mjs",
    "test-critique-table-scroll": "node --test scripts/critique-table-scroll.test.mjs",
    "test-corner-shape-values": "node --test scripts/corner-shape-values.test.mjs",
