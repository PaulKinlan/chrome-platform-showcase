    "worklist": "node scripts/build-worklist.mjs",
    "audit": "python3 .claude/audit-demos.py",
    "auto-research": "node tools/auto-research.ts",
    "route-manifest": "node scripts/route-manifest.mjs",
    "check-routes": "node scripts/check-routes.mjs",
    "demo-index": "node scripts/build-demo-index.mjs",
    "check-demo-index": "node scripts/build-demo-index.mjs --check",
    "gen:feature-servers": "node scripts/build-feature-servers.mjs",
    "check-feature-servers": "node scripts/build-feature-servers.mjs --check",
    "check:writing": "node scripts/check-writing.mjs --changed",
    "check:jank": "node scripts/check-jank.mjs",
