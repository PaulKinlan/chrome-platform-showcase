    "test-conformance-runner": "node --test scripts/conformance-runner.test.mjs",
    "test-hardening": "node --test scripts/server-hardening.test.mjs",
    "test-font-loading": "node scripts/check-font-loading.mjs",
    "test-webrtc-diagnostic-logging": "node --test scripts/webrtc-diagnostic-logging.test.mjs",
    "test-entity-scripts": "node --test scripts/entity-escaped-script.test.mjs",
    "test-webxr-depth-router": "node --test scripts/webxr-depth-router.test.mjs",
