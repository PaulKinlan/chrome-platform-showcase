    "@types/ws": "8.18.2",
    "dprint": "0.65.0",
    "typescript": "5.9.3",
    "wrangler": "4.167.0",
    "ws": "8.23.0",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=22.18"
  }
