{
  "lineWidth": 100,
  "indentWidth": 2,
  "useTabs": false,
  "newLineKind": "lf",
  "typescript": {
    "deno": true,
    "lineWidth": 100
  },
  "json": {
    "deno": true,
    "lineWidth": 100
  },
  "markdown": {
    "deno": true,
    "lineWidth": 100,
    "textWrap": "always"
  },
  "excludes": [
    "**/node_modules",
    "dist",
    ".wrangler",
    "**/*.html",
    "**/*.css",
    "v[0-9]*/**/*.js",
    "v[0-9]*/**/*.json",
    "v156/avoid-caching-module-failures/modules/parse-error.js",
    "routes/_feature-servers.generated.ts",
    "reports/conformance-sweep.md",
    "reports/concept-overflow-manifest.md",
    "reports/conformance-sweep-triage.md",
    "package-lock.json"
  ],
  "plugins": [
    "./node_modules/@dprint/typescript/plugin.wasm",
    "./node_modules/@dprint/json/plugin.wasm",
    "./node_modules/@dprint/markdown/plugin.wasm"
  ]
}
