      "id": "geolocation-display-mode-idl-exists",
      "description": "document.createElement('geolocation') exposes the displayMode IDL property reflecting the display-mode attribute.",
      "kind": "script",
      "test": "(()=>{try{const el=document.createElement('geolocation');return 'displayMode' in el;}catch(e){return false;}})()",
      "specSection": "https://w3c.github.io/mediacapture-extensions/#media-capture-html-elements",
      "expectedBrowsers": [
        "chrome"
      ]
    },
    {
      "id": "usermedia-display-mode-idl-reflection",
      "description": "Setting display-mode=\"icon-only\" on <usermedia> reflects 'icon-only' on element.displayMode.",
      "kind": "script",
      "test": "(()=>{try{const el=document.createElement('usermedia');el.setAttribute('display-mode','icon-only');return 'displayMode' in el&&el.displayMode==='icon-only';}catch(e){return false;}})()",
      "specSection": "https://w3c.github.io/mediacapture-extensions/#media-capture-html-elements",
      "expectedBrowsers": [
        "chrome"
      ]
    },
    {
      "id": "icon-variant-idl-reflection",
      "description": "Capability elements expose iconVariant IDL reflection for the icon-variant content attribute.",
      "kind": "script",
      "test": "(()=>{try{const el=document.createElement('geolocation');el.setAttribute('icon-variant','outline');return 'iconVariant' in el&&typeof el.iconVariant==='string'&&el.iconVariant.length>0;}catch(e){return false;}})()",
      "specSection": "https://w3c.github.io/mediacapture-extensions/#media-capture-html-elements",
      "expectedBrowsers": [
        "chrome"
      ]
    },
    {
      "id": "capability-element-constructors-exist",
      "description": "Window exposes HTMLGeolocationElement or HTMLUserMediaElement alongside displayMode reflection.",
      "kind": "script",
      "test": "(()=>{try{const hasCtor=('HTMLGeolocationElement' in window)||('HTMLUserMediaElement' in window);const geo=document.createElement('geolocation');return hasCtor&&('displayMode' in geo);}catch(e){return false;}})()",
      "specSection": "https://w3c.github.io/mediacapture-extensions/#media-capture-html-elements",
      "expectedBrowsers": [
        "chrome"
      ]
    }
  ]
