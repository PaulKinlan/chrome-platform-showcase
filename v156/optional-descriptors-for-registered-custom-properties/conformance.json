      "specSection": "https://drafts.css-houdini.org/css-properties-values-api-1/#the-registerproperty-function"
    },
    {
      "id": "at-property-rule-supported",
      "description": "The @property rule is parsed by this browser.",
      "kind": "script",
      "test": "(()=>{try{return CSS.supports('at-rule(@property)')||typeof CSSPropertyRule!=='undefined';}catch(e){return typeof CSSPropertyRule!=='undefined';}})()",
      "specSection": "https://drafts.css-houdini.org/css-properties-values-api-1/#at-property-rule"
    },
    {
      "id": "inherits-may-be-omitted",
      "description": "A registration with only a syntax must be accepted: inherits is no longer a required member. Before Chrome 156 this threw a TypeError from WebIDL because inherits was declared required.",
      "kind": "script",
      "test": "(()=>{const n='--conf-omit-inherits-'+Math.floor(performance.now());try{CSS.registerProperty({name:n,syntax:'*'});return true;}catch(e){return false;}})()",
      "specSection": "https://drafts.css-houdini.org/css-properties-values-api-1/#dom-propertydefinition-inherits"
    },
    {
      "id": "initial-value-may-be-omitted-on-typed-syntax",
      "description": "A typed syntax with no initial-value must be accepted. Before Chrome 156 this threw a SyntaxError: 'An initial value must be provided if the syntax is not *'. This is the omission that makes per-use var() fallbacks possible on a typed property.",
      "kind": "script",
      "test": "(()=>{const n='--conf-omit-initial-'+Math.floor(performance.now());try{CSS.registerProperty({name:n,syntax:'<length>',inherits:false});return true;}catch(e){return false;}})()",
      "specSection": "https://drafts.css-houdini.org/css-properties-values-api-1/#dom-propertydefinition-initialvalue"
    },
    {
      "id": "omitted-initial-value-leaves-var-fallback-reachable",
      "description": "With no initial-value the property is guaranteed-invalid until set, so var(--x, fallback) resolves to its fallback. This is the observable consequence authors wanted, not just a looser parse.",
      "kind": "script",
      "test": "(()=>{const n='--conf-fallback-'+Math.floor(performance.now());try{CSS.registerProperty({name:n,syntax:'<length>',inherits:false});}catch(e){return false;}const el=document.createElement('div');el.style.position='absolute';el.style.visibility='hidden';document.body.appendChild(el);el.style.paddingLeft='var('+n+', 40px)';const used=getComputedStyle(el).paddingLeft;el.remove();return used==='40px';})()",
      "specSection": "https://drafts.css-houdini.org/css-properties-values-api-1/#guaranteed-invalid"
    },
    {
      "id": "syntax-may-be-omitted",
      "description": "A registration with neither syntax nor any other descriptor must be accepted, defaulting to the universal syntax.",
      "kind": "script",
      "test": "(()=>{const n='--conf-omit-all-'+Math.floor(performance.now());try{CSS.registerProperty({name:n});return true;}catch(e){return false;}})()",
      "specSection": "https://drafts.css-houdini.org/css-properties-values-api-1/#dom-propertydefinition-syntax"
    },
    {
      "id": "name-is-still-required",
      "description": "Relaxing the descriptors must not relax the name: a registration with no name is still a TypeError.",
      "kind": "throws",
      "test": "CSS.registerProperty({ syntax: '<length>' })",
      "specSection": "https://drafts.css-houdini.org/css-properties-values-api-1/#dom-propertydefinition-name"
    },
    {
      "id": "duplicate-registration-still-rejected",
      "description": "A name can only be registered once per document, whatever descriptors it carries. This anchors the relaxation against a rule that has not changed, and is why every demo here uses a fresh name per attempt.",
      "kind": "script",
      "test": "(()=>{const n='--conf-dup-'+Math.floor(performance.now());try{CSS.registerProperty({name:n,syntax:'*',inherits:false});}catch(e){return false;}try{CSS.registerProperty({name:n,syntax:'*',inherits:false});return false;}catch(e){return e.name==='InvalidModificationError';}})()",
      "specSection": "https://drafts.css-houdini.org/css-properties-values-api-1/#the-registerproperty-function"
