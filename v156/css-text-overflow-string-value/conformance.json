  "assertions": [
    {
      "id": "css-supports-single-string",
      "description": "CSS.supports accepts a quoted custom string value for text-overflow (' (more)').",
      "kind": "css-supports",
      "test": "text-overflow: ' (more)'",
      "specSection": "https://drafts.csswg.org/css-overflow-4/#text-overflow",
      "expectedBrowsers": [
        "chrome",
        "firefox"
      ]
    },
    {
      "id": "css-supports-two-value-strings",
      "description": "CSS.supports accepts two-value start and end strings for text-overflow ('< ' ' >').",
      "kind": "css-supports",
      "test": "text-overflow: '< ' ' >'",
      "specSection": "https://drafts.csswg.org/css-overflow-4/#text-overflow",
      "expectedBrowsers": [
        "chrome",
        "firefox"
      ]
    },
    {
      "id": "computed-style-serializes-custom-string",
      "description": "Setting style.textOverflow to a quoted string ('…') preserves and serializes the string value through getComputedStyle(el).textOverflow instead of dropping the declaration.",
      "kind": "script",
      "test": "(()=>{try{const el=document.createElement('div');el.style.overflow='hidden';el.style.whiteSpace='nowrap';el.style.textOverflow='\"…\"';document.body.appendChild(el);const cs=getComputedStyle(el).textOverflow;el.remove();return typeof cs==='string'&&cs.includes('…')&&cs!=='clip'&&cs!=='ellipsis';}catch(e){return false;}})()",
      "specSection": "https://drafts.csswg.org/css-overflow-4/#text-overflow",
      "expectedBrowsers": [
        "chrome",
        "firefox"
      ]
    },
    {
      "id": "computed-style-two-value-mixed",
      "description": "Two-value text-overflow combining a start string and end string parses and retains both tokens in computed style.",
      "kind": "script",
      "test": "(()=>{try{const el=document.createElement('div');el.style.overflow='hidden';el.style.whiteSpace='nowrap';el.style.textOverflow='\"‹ \" \" ›\"';document.body.appendChild(el);const cs=getComputedStyle(el).textOverflow;el.remove();return typeof cs==='string'&&cs.includes('‹')&&cs.includes('›');}catch(e){return false;}})()",
      "specSection": "https://drafts.csswg.org/css-overflow-4/#text-overflow",
      "expectedBrowsers": [
        "chrome",
        "firefox"
      ]
    }
  ]
}
