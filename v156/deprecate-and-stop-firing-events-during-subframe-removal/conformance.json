    {
      "id": "remove-omits-pagehide",
      "description": "Removing a same-origin srcdoc iframe with iframe.remove() does not fire pagehide on the subframe's window (destroy a child navigable does not unload the document).",
      "kind": "script",
      "test": "(async()=>{const host=document.createElement('div');host.style.cssText='position:absolute;left:-9999px;top:0;width:1px;height:1px;overflow:hidden';document.body.appendChild(host);const f=document.createElement('iframe');f.srcdoc='<p>f</p>';const fok=await Promise.race([new Promise(r=>{f.onload=()=>r(true);host.appendChild(f);}),new Promise(r=>setTimeout(()=>r(false),4000))]);if(!fok){host.remove();return false;}const ev=[];f.contentWindow.addEventListener('pagehide',()=>ev.push('pagehide'));f.contentDocument.addEventListener('visibilitychange',()=>ev.push('visibilitychange'));f.contentWindow.addEventListener('unload',()=>ev.push('unload'));f.remove();host.remove();return !ev.includes('pagehide');})()",
      "specSection": "https://html.spec.whatwg.org/multipage/document-sequences.html#destroy-a-child-navigable"
    },
    {
      "id": "remove-omits-visibilitychange",
