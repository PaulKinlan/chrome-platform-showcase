    {
      "id": "removechild-omits-all",
      "description": "parentNode.removeChild(iframe) on a same-origin iframe fires none of pagehide, visibilitychange or unload in the subframe.",
      "kind": "script",
      "test": "(async()=>{const host=document.createElement('div');host.style.cssText='position:absolute;left:-9999px;top:0;width:1px;height:1px;overflow:hidden';document.body.appendChild(host);const f=document.createElement('iframe');f.srcdoc='<p>f</p>';const fok=await Promise.race([new Promise(r=>{f.onload=()=>r(true);host.appendChild(f);}),new Promise(r=>setTimeout(()=>r(false),4000))]);if(!fok){host.remove();return false;}const ev=[];f.contentWindow.addEventListener('pagehide',()=>ev.push('pagehide'));f.contentDocument.addEventListener('visibilitychange',()=>ev.push('visibilitychange'));f.contentWindow.addEventListener('unload',()=>ev.push('unload'));host.removeChild(f);host.remove();return ev.length===0;})()",
      "specSection": "https://html.spec.whatwg.org/multipage/document-sequences.html#destroy-a-child-navigable"
    },
    {
      "id": "ancestor-innerhtml-omits-all",
      "description": "Clearing an ancestor with innerHTML = '' destroys a contained same-origin iframe without firing pagehide, visibilitychange or unload.",
      "kind": "script",
      "test": "(async()=>{const host=document.createElement('div');host.style.cssText='position:absolute;left:-9999px;top:0;width:1px;height:1px;overflow:hidden';document.body.appendChild(host);const w=document.createElement('div');host.appendChild(w);const f=document.createElement('iframe');f.srcdoc='<p>f</p>';const fok=await Promise.race([new Promise(r=>{f.onload=()=>r(true);w.appendChild(f);}),new Promise(r=>setTimeout(()=>r(false),4000))]);if(!fok){host.remove();return false;}const ev=[];f.contentWindow.addEventListener('pagehide',()=>ev.push('pagehide'));f.contentDocument.addEventListener('visibilitychange',()=>ev.push('visibilitychange'));f.contentWindow.addEventListener('unload',()=>ev.push('unload'));w.innerHTML='';host.remove();return ev.length===0;})()",
      "specSection": "https://html.spec.whatwg.org/multipage/document-sequences.html#destroy-a-child-navigable"
    },
    {
      "id": "nested-same-origin-omits-all",
      "description": "Removing an outer same-origin iframe fires no detachment events in it or in its nested same-origin iframe.",
      "kind": "script",
      "test": "(async()=>{const host=document.createElement('div');host.style.cssText='position:absolute;left:-9999px;top:0;width:1px;height:1px;overflow:hidden';document.body.appendChild(host);const o=document.createElement('iframe');o.srcdoc='<p>o</p>';const ook=await Promise.race([new Promise(r=>{o.onload=()=>r(true);host.appendChild(o);}),new Promise(r=>setTimeout(()=>r(false),4000))]);if(!ook){host.remove();return false;}const od=o.contentDocument;const i=od.createElement('iframe');i.srcdoc='<p>i</p>';const iok=await Promise.race([new Promise(r=>{i.onload=()=>r(true);od.body.appendChild(i);}),new Promise(r=>setTimeout(()=>r(false),4000))]);if(!iok){host.remove();return false;}const eo=[];o.contentWindow.addEventListener('pagehide',()=>eo.push('pagehide'));o.contentDocument.addEventListener('visibilitychange',()=>eo.push('visibilitychange'));o.contentWindow.addEventListener('unload',()=>eo.push('unload'));const ei=[];i.contentWindow.addEventListener('pagehide',()=>ei.push('pagehide'));i.contentDocument.addEventListener('visibilitychange',()=>ei.push('visibilitychange'));i.contentWindow.addEventListener('unload',()=>ei.push('unload'));o.remove();host.remove();return eo.length===0&&ei.length===0;})()",
      "specSection": "https://html.spec.whatwg.org/multipage/document-sequences.html#destroy-a-child-navigable"
    },
    {
      "id": "sandbox-allow-same-origin-omits-all",
      "description": "A sandboxed iframe with allow-same-origin (still scriptable by the parent) fires no detachment events when removed.",
      "kind": "script",
      "test": "(async()=>{const host=document.createElement('div');host.style.cssText='position:absolute;left:-9999px;top:0;width:1px;height:1px;overflow:hidden';document.body.appendChild(host);const f=document.createElement('iframe');f.sandbox='allow-scripts allow-same-origin';f.srcdoc='<p>f</p>';const fok=await Promise.race([new Promise(r=>{f.onload=()=>r(true);host.appendChild(f);}),new Promise(r=>setTimeout(()=>r(false),4000))]);if(!fok){host.remove();return false;}const ev=[];f.contentWindow.addEventListener('pagehide',()=>ev.push('pagehide'));f.contentDocument.addEventListener('visibilitychange',()=>ev.push('visibilitychange'));f.contentWindow.addEventListener('unload',()=>ev.push('unload'));f.remove();host.remove();return ev.length===0;})()",
      "specSection": "https://html.spec.whatwg.org/multipage/document-sequences.html#destroy-a-child-navigable"
    },
    {
      "id": "initial-about-blank-omits-all",
      "description": "Removing an iframe that still holds its initial about:blank document fires no pagehide, visibilitychange or unload.",
      "kind": "script",
      "test": "(()=>{const f=document.createElement('iframe');f.style.cssText='position:absolute;left:-9999px;width:1px;height:1px';document.body.appendChild(f);const ev=[];f.contentWindow.addEventListener('pagehide',()=>ev.push('pagehide'));f.contentDocument.addEventListener('visibilitychange',()=>ev.push('visibilitychange'));f.contentWindow.addEventListener('unload',()=>ev.push('unload'));f.remove();return ev.length===0;})()",
      "specSection": "https://html.spec.whatwg.org/multipage/document-sequences.html#destroy-a-child-navigable"
    },
    {
      "id": "navigation-still-unloads",
      "description": "Navigating a same-origin iframe (a new document commits) still fires pagehide, visibilitychange and unload, in that order — only removal changed.",
      "kind": "script",
      "test": "(async()=>{const host=document.createElement('div');host.style.cssText='position:absolute;left:-9999px;top:0;width:1px;height:1px;overflow:hidden';document.body.appendChild(host);const f=document.createElement('iframe');f.srcdoc='<p>f</p>';const fok=await Promise.race([new Promise(r=>{f.onload=()=>r(true);host.appendChild(f);}),new Promise(r=>setTimeout(()=>r(false),4000))]);if(!fok){host.remove();return false;}const ev=[];f.contentWindow.addEventListener('pagehide',()=>ev.push('pagehide'));f.contentDocument.addEventListener('visibilitychange',()=>ev.push('visibilitychange'));f.contentWindow.addEventListener('unload',()=>ev.push('unload'));const nav=await Promise.race([new Promise(r=>{f.onload=()=>r(true);f.srcdoc='<p>next</p>';}),new Promise(r=>setTimeout(()=>r(false),4000))]);host.remove();return nav&&ev.join(',')==='pagehide,visibilitychange,unload';})()",
      "specSection": "https://html.spec.whatwg.org/multipage/document-lifecycle.html#unload-a-document",
      "expectedBrowsers": [
        "firefox",
        "safari"
      ]
    }
