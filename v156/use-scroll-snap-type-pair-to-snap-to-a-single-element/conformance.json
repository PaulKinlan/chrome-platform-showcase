      "id": "computed-style-scroll-snap-type-pair-serialization",
      "description": "Assigning scroll-snap-type: pair mandatory to a scroll container retains and serializes 'pair' in getComputedStyle(el).scrollSnapType while rejecting invalid axis keywords.",
      "kind": "script",
      "test": "(()=>{try{const el=document.createElement('div');el.style.scrollSnapType='pair mandatory';document.body.appendChild(el);const cs=getComputedStyle(el).scrollSnapType;el.remove();const bad=CSS.supports('scroll-snap-type','pair-invalid mandatory');return cs.includes('pair')&&!bad;}catch(e){return false;}})()",
      "specSection": "https://drafts.csswg.org/css-scroll-snap-1/#propdef-scroll-snap-type",
      "expectedBrowsers": [
        "chrome"
      ]
    },
    {
      "id": "pair-snaps-both-axes-to-same-element",
      "description": "In a 2D scroll container with staggered child elements at (40, 260) and (260, 40) and scroll-snap-type: pair mandatory, scrolling to (40, 40) snaps to one of the two elements rather than resting at the empty cross-axis intersection (40, 40).",
      "kind": "script",
      "test": "(()=>{try{if(!CSS.supports('scroll-snap-type','pair mandatory'))return false;const scroller=document.createElement('div');scroller.style.cssText='position:fixed;left:-9999px;top:0;width:200px;height:200px;overflow:scroll;scroll-snap-type:pair mandatory;';const surface=document.createElement('div');surface.style.cssText='position:relative;width:700px;height:700px;';const mk=(x,y)=>{const c=document.createElement('div');c.style.cssText=`position:absolute;left:${x}px;top:${y}px;width:120px;height:120px;scroll-snap-align:start;`;return c;};surface.append(mk(40,260),mk(260,40));scroller.appendChild(surface);document.body.appendChild(scroller);scroller.scrollTo(40,40);const sx=scroller.scrollLeft,sy=scroller.scrollTop;scroller.remove();const atPhantom=Math.abs(sx-40)<5&&Math.abs(sy-40)<5;return !atPhantom;}catch(e){return false;}})()",
      "specSection": "https://drafts.csswg.org/css-scroll-snap-1/#snap-axis",
      "expectedBrowsers": [
        "chrome"
      ]
    }
